  "title": "产区行 ～ 巴西～202407 ～记录3～品种，科研，未来与人",
  "source_url": "https://mp.weixin.qq.com/s/_UcLp89K05o1Bmb0Fhf9RA",
  "publish_time": 1722304704,
  "status": "body_recovered",
