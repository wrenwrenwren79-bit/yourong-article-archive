;\"/>\n</section>\n<section powered-by=\"werss\" style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;line-height: 1.75em;letter-spacing: 0.034em;font-style: normal;font-weight: normal;margin-bottom: 0px;margin-top: 0px;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7SkB6M2kMYzk2Ea1BO4eOlaO8st3wWJAg8NrbKv0ymTtX1xo0yeJBml4nzPibBlPff0RqafqOu42FQ/640?wx_fmt=other&amp;from=appmsg&amp;tp=webp&amp;wxfrom=10005&amp;wx_lazy=1&amp;wx_co=1\" style=\"outline: 0px;border-radius: 8px;background-size: 16px auto !important;height: 419.363889px !important;visibility: visible !important;width: 677px !important;\"/>\n</section>\n<section powered-by=\"werss\" style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;line-height: 1.75em;letter-spacing: 0.034em;font-style: normal;font-weight: normal;margin-bottom: 0px;margin-top: 0px;'>\n<img src=\"https://mmbiz.qpic.cn/mmbiz_png/Gr457cyFia7S0n5Q6QGTxOt7fcwvWhXybN8TpxQTsWIqk4txDp2XgxFEq4cQia7QoMrwoYNLTxCx8bYzLlaCFjxA/640?wx_fmt=other&amp;tp=webp&amp;wxfrom=10005&amp;wx_lazy=1&amp;wx_co=1\" style=\"outline: 0px;border-radius: 8px;background-size: 16px auto !important;height: 902.666667px !important;visibility: visible !important;width: 677px !important;\"/>\n</section>\n<section powered-by=\"werss\" style=\"margin-bottom: 0px;margin-top: 0px;line-height: 1.75em;text-align: center;\">\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n           胡宁区域在秘鲁中部，是上图橙色部分，图片来源CAFE IMPORTS网站\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"margin-bottom: 0px;margin-top: 0px;line-height: 1.75em;\">\n<strong>\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<br/>\n</span>\n</strong>\n</section>\n<section powered-by=\"werss\" style=\"margin-bottom: 0px;margin-top: 0px;line-height: 1.75em;\">\n<strong>\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;font-weight: bold;\">\n            关于美景庄园\n           </span>\n</span>\n</strong>\n</section>\n<section powered-by=\"werss\" style=\"margin-bottom: 0px;margin-top: 0px;line-height: 1.75em;\">\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n           驾驶四驱卡车从乌布里基镇中心到达美景庄园，大约需要45分钟。从这里可以看到整个乌布里基山谷 (Ubiriki Valley) 的美丽景色，美景庄园因此得名。\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7TPeHg2cAkgwc3ofTsyoeD8QsI3Kq4D5kVQ4QyRk0EBhAh5wC8UMicrelZIfJhD8pUeHEae4ecRWtg/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7TPeHg2cAkgwc3ofTsyoeD8fzn6oiaQexQA4phxNc4UcNQHf21YDnBVicns06A9EvHH57cibKvnKIoSg/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style=\"margin-bottom: 0px;margin-top: 0px;line-height: 1.75em;\">\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n           美景庄园是在2013年叶锈病爆发后被收购的。在那之前，这里的咖啡种植海拔只有1150米；2014年，丹尼尔在庄园的更高海拔处种植了哥斯达黎加和瑰夏，这也是到目前为止，胜景庄园仅有的两个品种。\n          </span>\n</span>\n<p style=\"margin-bottom: 0px;margin-top: 0px;line-height: 1.75em;\">\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<br/>\n</span>\n</p>\n</section>\n<section powered-by=\"werss\" style=\"margin-bottom: 0px;margin-top: 0px;line-height: 1.75em;text-align: center;\">\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n           公众号的文章栏目有更多的咖啡信息\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"margin-bottom: 0px;margin-top: 0px;line-height: 1.75em;text-align: center;\">\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n           客服微信：sabh_lt （售前/售后/加群）\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"margin-bottom: 0px;margin-top: 0px;line-height: 1.75em;\">\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7RicESSboT2yAGicv25eicYwA9eYTVnj6tnDXYWHJ5amUjBqzNK6pdB5dhozgCKLqOuf9IgicGe5pVLibQ/640?wx_fmt=other&amp;wxfrom=10005&amp;wx_lazy=1&amp;wx_co=1&amp;tp=webp\" style=\"outline: 0px;border-radius: 8px;letter-spacing: normal;text-align: start;font-size: 17px;caret-color: rgb(0, 0, 0);color: rgb(0, 0, 0);background-size: 16px auto !important;height: 187.85px !important;visibility: visible !important;width: 578px !important;\"/>\n</span>\n</section>\n<p style=\"display: none;\">\n<mp-style-type data-value=\"3\">\n</mp-style-type>\n</p>\n</div>",
