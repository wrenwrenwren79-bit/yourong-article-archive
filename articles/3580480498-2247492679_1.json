EQwLeobWZz5njtWWJ7tzuwicwjzvedd5bQgXlkbELLjlnukk5AOKA/640?wx_fmt=jpeg&amp;wxfrom=5&amp;wx_lazy=1&amp;wx_co=1\" style=\"outline: 0px;font-size: var(--articleFontsize);letter-spacing: 0.034em;visibility: visible !important;width: 677px !important;\"/>\n<br style=\"outline: 0px;\"/>\n</p>\n<p style='margin-bottom: 0px;outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;line-height: 1.75em;'>\n<span style=\"outline: 0px;color: black;font-family: Calibri, sans-serif;font-size: 14px;\">\n</span>\n</p>\n<p style='margin-bottom: 0px;outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;text-align: center;'>\n<img src=\"https://mmbiz.qpic.cn/mmbiz_png/Gr457cyFia7Tia6593icv0lvf4dHREGOfbmAfP622IA0ctib7XLruCiaic1fylcq16UlTRsAfTqJ7ic2yrts31yszWxsw/640?wx_fmt=jpeg&amp;wxfrom=5&amp;wx_lazy=1&amp;wx_co=1\" style=\"outline: 0px;visibility: visible !important;width: 677px !important;\"/>\n</p>\n<p style='margin-bottom: 0px;outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;text-align: center;'>\n<span style=\"outline: 0px;color: rgb(178, 178, 178);font-size: 14px;\">\n          洛哈在厄瓜多尔的南部\n         </span>\n</p>\n<p style='margin-bottom: 0px;outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;text-align: center;'>\n<span style=\"outline: 0px;color: rgb(178, 178, 178);font-size: 14px;\">\n          图片来源\n          <a data-linktype=\"2\" href=\"https://www.cafeimports.com/europe/ecuador\" style=\"outline: 0px;color: rgb(87, 107, 149);-webkit-user-drag: none;cursor: pointer;\" target=\"_blank\">\n           CAFE IMPORT\n          </a>\n</span>\n</p>\n<p style='margin-bottom: 0px;outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;'>\n<strong style=\"outline: 0px;\">\n<span style=\"outline: 0px;font-size: 14px;\">\n<br style=\"outline: 0px;\"/>\n</span>\n</strong>\n</p>\n<p style='margin-bottom: 0px;outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;'>\n<strong style=\"outline: 0px;\">\n<span style=\"outline: 0px;font-size: 14px;\">\n           关于\n          </span>\n<span style=\"outline: 0px;font-family: 微软雅黑;\">\n<span style=\"outline: 0px;font-size: 13.3333px;\">\n<span style='font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;'>\n             Hacienda La Papaya\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n</span>\n</span>\n</strong>\n</p>\n<hr style='outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;border-right-width: 0px;border-style: solid;border-color: rgba(0, 0, 0, 0.1);border-bottom-width: 0px;border-left-width: 0px;transform: scale(1, 0.5);transform-origin: 0px 0px;'/>\n<p style='margin-bottom: 0px;outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n</span>\n</p>\n<p style='margin-bottom: 0px;outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;'>\n<span style=\"font-family: 微软雅黑;font-size: 10pt;letter-spacing: 0.544px;\">\n          木瓜庄园位于厄瓜多尔南部的Saraguro镇旁边，庄园负责人Juan\n         </span>\n<span style=\"font-family: 微软雅黑;font-size: 10pt;letter-spacing: 0.544px;\">\n          拥有农学学位；Juan是从2010年开始接触咖啡，虽然庄园已经属于家族很久很久年头；由于曾经有玫瑰种植管理的经验以及有农学学位的专业背景，Juan\n         </span>\n<span style=\"font-family: 微软雅黑;font-size: 10pt;letter-spacing: 0.544px;\">\n          以一丝不苟和科学的方法全身心投入到对高品质咖啡的追求中，\n         </span>\n<span style=\"font-family: 微软雅黑;font-size: 10pt;letter-spacing: 0.544px;\">\n          他对实验的痴迷和对科学证据的需求是他每个阶段工作的基石，从仔细施用和监测施肥、收获期间不断测量Brix糖度和咖啡鲜果重量、严谨的发酵的创新，到严格的干燥过程；为了更好的与市场对接，以及更多的推广厄瓜多尔小农的咖啡，他创立了一家名为 CaféExporto 的出口公司\n         </span>\n<span style=\"letter-spacing: 0.544px;font-family: 微软雅黑;font-size: 10pt;\">\n          。\n         </span>\n</p>\n<p style='margin-bottom: 0px;outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;'>\n<br/>\n</p>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;text-indent: 0em;white-space: normal;line-height: 1.6em;'>\n<strong style=\"outline: 0px;\">\n<span style=\"outline: 0px;color: rgb(34, 34, 34);background-color: rgb(255, 255, 255);font-size: 14px;letter-spacing: 1px;text-decoration-style: solid;text-decoration-color: rgb(34, 34, 34);\">\n</span>\n</strong>\n</section>\n<p>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7RAEdlib7TPwnZRwUYPMiazrrUQuQlww7ZzsRE9lR7QU2WHeSr4Xz8cbmgoFDk3SVW0HPyd9JRAiaRwA/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</p>\n<section powered-by=\"werss\" style=\"line-height: 1.6em;text-align: justify;margin: 0px;text-indent: 0em;\">\n<strong>\n<span style=\"color: rgb(34, 34, 34);background-color: rgb(255, 255, 255);font-size: 14px;letter-spacing: 1px;text-decoration: none;\">\n           Typica Mejorada 增强（改良）铁皮卡~\n          </span>\n</strong>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.6em;text-align: justify;margin: 0px;text-indent: 0em;\">\n<span style=\"color: rgb(34, 34, 34);background-color: rgb(255, 255, 255);font-size: 14px;letter-spacing: 1px;text-decoration: none;\">\n          这个是厄瓜多尔近几年很火热的一个品种，与Sidra并驾齐驱横扫厄瓜多尔的咖啡生豆赛事，但据世界咖啡研究中心WCR的基因检测结果，它可能是一个波旁品种与埃塞的某原生品种杂交而得，目前在厄瓜多尔和哥斯达黎加都有种植。\n         </span>\n</section>\n<p style=\"text-align: center;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7RAEdlib7TPwnZRwUYPMiazrr9kIL91pXVFcrQjCgEGyzWIJdc0zKTnQ5p98yqXNrSnISV8vichJmicYA/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</p>\n<section powered-by=\"werss\" style=\"line-height: 1.6em;text-align: justify;margin: 0px;text-indent: 0em;\">\n<span style=\"color: rgb(34, 34, 34);background-color: rgb(255, 255, 255);font-size: 14px;letter-spacing: 1px;text-decoration: none;\">\n</span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.6em;text-align: justify;margin: 0px;text-indent: 0em;\">\n<strong>\n<span style=\"color:#222222;\">\n<span style=\"caret-color: rgb(34, 34, 34);font-size: 14px;letter-spacing: 1px;background-color: rgb(255, 255, 255);\">\n            关于橡木桶处理\n           </span>\n</span>\n</strong>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.6em;text-align: justify;margin: 0px;text-indent: 0em;\">\n<span style=\"color:#222222;\">\n<span style=\"caret-color: rgb(34, 34, 34);font-size: 14px;letter-spacing: 1px;background-color: rgb(255, 255, 255);\">\n           这个批次的橡木桶处理使用的是厄瓜多尔本国酿制朗姆酒的酒桶，它在处理咖啡前用来陈年朗姆酒二十年了，咖啡鲜果放入橡木桶中静置厌氧发酵，期间橡木桶放置在低温（不高于18摄氏度）的暗房中，发酵5天后取出晒床晾晒；\n           <span style=\"display: none;line-height: 0px;\">\n            ‍\n           </span>\n<span style=\"display: none;line-height: 0px;\">\n            ‍\n           </span>\n<span style=\"display: none;line-height: 0px;\">\n            ‍\n           </span>\n<span style=\"display: none;line-height: 0px;\">\n            ‍\n           </span>\n<span style=\"display: none;line-height: 0px;\">\n            ‍\n           </span>\n<span style=\"display: none;line-height: 0px;\">\n            ‍\n           </span>\n<span style=\"display: none;line-height: 0px;\">\n            ‍\n           </span>\n<span style=\"display: none;line-height: 0px;\">\n            ‍\n           </span>\n<span style=\"display: none;line-height: 0px;\">\n            ‍\n           </span>\n<span style=\"display: none;line-height: 0px;\">\n            ‍\n           </span>\n<span style=\"display: none;line-height: 0px;\">\n            ‍\n           </span>\n<span style=\"display: none;line-height: 0px;\">\n            ‍\n           </span>\n<span style=\"display: none;line-height: 0px;\">\n            ‍\n           </span>\n<span style=\"display: none;line-height: 0px;\">\n            ‍\n           </span>\n<span style=\"display: none;line-height: 0px;\">\n            ‍\n           </span>\n<span style=\"display: none;line-height: 0px;\">\n            ‍\n           </span>\n<span style=\"display: none;line-height: 0px;\">\n            ‍\n           </span>\n<span style=\"display: none;line-height: 0px;\">\n            ‍\n           </span>\n</span>\n</span>\n</section>\n<p style=\"text-align: center;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7RAEdlib7TPwnZRwUYPMiazrribDEsd2jDNiabgIAava4ickwXorJGaxNGhPk0w69RR9cRwOia0Aibbg8pvQ/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</p>\n<section powered-by=\"werss\" style=\"line-height: 1.6em;text-align: justify;margin: 0px;text-indent: 0em;\">\n<span style=\"color:#222222;\">\n<span style=\"caret-color: rgb(34, 34, 34);font-size: 14px;letter-spacing: 1px;background-color: rgb(255, 255, 255);\">\n</span>\n</span>\n</section>\n<p style='margin-bottom: 0px;outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;text-indent: 0em;white-space: normal;line-height: 1.75em;'>\n<span style=\"outline: 0px;color: rgb(34, 34, 34);background-color: rgb(255, 255, 255);font-size: 14px;letter-spacing: 1px;text-decoration-style: solid;text-decoration-color: rgb(34, 34, 34);\">\n<br/>\n</span>\n</p>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;line-height: 1.75em;text-align: center;'>\n<span style='outline: 0px;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;background-color: rgb(255, 255, 255);'>\n          更多咖啡豆选购，请关注收藏小程序和淘宝店铺哦～\n         </span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n          公众号的文章栏目有更多的咖啡信息\n         </span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;'>\n<span style='outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;'>\n          客服微信：sabh_lt （售前/售后/加群）\n          <img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7RicESSboT2yAGicv25eicYwA9eYTVnj6tnDXYWHJ5amUjBqzNK6pdB5dhozgCKLqOuf9IgicGe5pVLibQ/640?wx_fmt=jpeg&amp;wxfrom=5&amp;wx_lazy=1&amp;wx_co=1\" style=\"outline: 0px;letter-spacing: normal;text-align: start;font-size: var(--articleFontsize);caret-color: rgb(0, 0, 0);color: rgb(0, 0, 0);visibility: visible !important;width: 578px !important;\"/>\n</span>\n</section>\n<p style='margin-bottom: 0px;outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;text-indent: 0em;white-space: normal;line-height: 1.75em;'>\n<span style=\"outline: 0px;color: rgb(34, 34, 34);background-color: rgb(255, 255, 255);font-size: 14px;letter-spacing: 1px;text-decoration-style: solid;text-decoration-color: rgb(34, 34, 34);\">\n<br/>\n</span>\n</p>\n<p>\n<br/>\n</p>\n<p style=\"display: none;\">\n<mp-style-type data-value=\"3\">\n</mp-style-type>\n</p>\n</div>",
