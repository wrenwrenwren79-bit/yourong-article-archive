55, 255, 255);text-decoration-style: initial;text-decoration-color: initial;border-style: solid;border-right-width: 0px;border-bottom-width: 0px;border-left-width: 0px;border-color: rgba(0, 0, 0, 0.098);transform-origin: 0px 0px 0px;transform: scale(1, 0.5);visibility: visible;'/>\n<section powered-by=\"werss\" style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;background-color: rgb(255, 255, 255);text-decoration-style: initial;text-decoration-color: initial;visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;visibility: visible;font-size: 14px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          先说一下 Jimma 和 Limmu（Limu）， 其实Limmu并非埃塞官方的Zone，它是对于生长在Jimma区和隔壁的Illubabor出产的部分咖啡的风味调性的分类命名，在埃塞商品交易中心公布的咖啡分类定义里有两类Limmu A和Limmu B，对于位于Jimma区内的Gera, Goma, Gumay, Kersa, Limu Kossa, Limu Seka, Mena, Seka Chekorsa, and Shebe Sambo等小镇出产的咖啡定义为Limmu A，对于Illubabor区内的Ale, Bedelle, Chora, Dedesa, Noppa, and Yayu等镇出产的咖啡定义为Limmu B。\n         </span>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;margin-bottom: 0em;line-height: 1.75em;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7R3bkPs5bgOd4PFsmwZ3I0QQpqZDeiaiafxmsNelwfYwgic9tvn8O1HFmdlcqibU0Td5srN6l8b0ialaNg/640?wx_fmt=jpeg\"/>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;margin-bottom: 0em;line-height: 1.75em;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7R3bkPs5bgOd4PFsmwZ3I0QP5CfiaHibUJvFkk3qo6uia6UJDQCur1ybQZrOziaG1ia9UaXPBNllxu5sSg/640?wx_fmt=png\"/>\n</section>\n<section powered-by=\"werss\" style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;background-color: rgb(255, 255, 255);text-decoration-style: initial;text-decoration-color: initial;visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<br/>\n</section>\n<section powered-by=\"werss\" style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;background-color: rgb(255, 255, 255);text-decoration-style: initial;text-decoration-color: initial;visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<strong>\n<span style=\"font-size: 14px;\">\n           关于Gera与Tracon\n          </span>\n</strong>\n<span style=\"font-size: 14px;\">\n</span>\n</section>\n<p style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;background-color: rgb(255, 255, 255);text-decoration-style: initial;text-decoration-color: initial;visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style='color: rgb(51, 51, 51);font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;'>\n          如今的吉拉是埃塞俄比亚西部的一个地区，其边界大致与 200 年前在这里存在的同名古老王国相吻合。\n         </span>\n<span style='color: rgb(51, 51, 51);font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;'>\n          吉\n         </span>\n<span style='color: rgb(51, 51, 51);font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;'>\n          拉是吉贝Gibe地区五个古奥罗莫王国之一，以出产优质的蜂蜜而闻名。\n         </span>\n<span style='color: rgb(51, 51, 51);font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;'>\n          金色的液体仍然是该地区的重要产品，现如今，咖啡豆也属于其中之一了。\n         </span>\n<br/>\n</p>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;margin-bottom: 0px;\">\n<span style=\"font-size: 14px;\">\n</span>\n</section>\n<p style=\"text-align: center;margin-bottom: 0em;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7R3bkPs5bgOd4PFsmwZ3I0Qmx6rhcjjVdGkGibzPKnqEFwGBz2N3DUictpDM20ICicZtNnaZrqRpI5zQ/640?wx_fmt=png\"/>\n</p>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;margin-bottom: 0px;\">\n<span style=\"font-size: 14px;\">\n          吉拉区是一个高海拔地区，超过一半的土地是古老的原始森林，\n         </span>\n<span style=\"font-size: 14px;\">\n          这样的组合使得这里非常适合种植咖啡树，事实上，这里有许多咖啡树是自然生长的。\n         </span>\n<span style=\"font-size: 14px;\">\n          吉\n         </span>\n<span style=\"font-size: 14px;\">\n          拉咖啡农场坐落在这个美丽的地区，占地1000公顷，大部分土地在海拔1780至2100米之间。\n         </span>\n</section>\n<p style=\"text-align: center;margin-bottom: 0em;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7R3bkPs5bgOd4PFsmwZ3I0Qn69iaeiaM7nwSWTYj2Jz9txe2JbRn8tb6MGP3z90NWicXiagPsACUVFyEg/640?wx_fmt=png\"/>\n</p>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;margin-bottom: 0px;\">\n<span style=\"font-size: 14px;\">\n          Tracon是一家大型家族出口企业，2008年建立了吉拉农场，开始在100公顷的土地上种植咖啡。每年都有更多的咖啡种植，截至2019年，约 500公顷的种植园都是茁壮，硕果累累的咖啡树。为了确保咖啡树能结出尽可能优质的咖啡果，Tracon的咖农与吉玛的研究所合作，来选择更优良的当地品种来种植。\n         </span>\n</section>\n<p style=\"text-align: center;margin-bottom: 0em;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7R3bkPs5bgOd4PFsmwZ3I0Qvhs2hWicugInWU2eopQhoKQvQNrtuVuicYibtqjCkxBbDhOpibcOPnfibQA/640?wx_fmt=jpeg\"/>\n</p>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;margin-bottom: 0px;\">\n<span style=\"font-size: 14px;\">\n          Gera农场每年收获近 50 万公斤的咖啡鲜果，其中80%做水洗处理，20%做日晒处理。\n         </span>\n<span style=\"font-size: 14px;\">\n          农场也努力维持其境内的天然森林。\n         </span>\n<span style=\"font-size: 14px;\">\n          虽然咖啡种植在某种程度上影响了该地区，但\n         </span>\n<span style=\"font-size: 14px;\">\n          Tracon的目标是将这些影响降到最低，并与该地区现存的野生动物和谐相处，保持深层森林栖息地不变。\n         </span>\n<span style=\"font-size: 14px;\">\n          毕竟，森林才是埃塞俄比亚咖啡独特风味的重要因素。\n         </span>\n</section>\n<p style=\"text-align: center;margin-bottom: 0em;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7R3bkPs5bgOd4PFsmwZ3I0Q1QRYIR3WHmuNYYicFnr4xiaI57n2nuFveT4Pwkk8eM0JXGS7EansdXKA/640?wx_fmt=png\"/>\n</p>\n<p style=\"margin-bottom: 0px;\">\n<span style=\"font-size: 14px;\">\n          获得认证是农场的另一项议程。\n         </span>\n<span style=\"font-size: 14px;\">\n          吉拉农场的咖啡是有机的，但还没有认证。\n         </span>\n<span style=\"font-size: 14px;\">\n          获得 UTZ 认证的工作正在进行中。\n         </span>\n<span style=\"font-size: 14px;\">\n          在此之后, Tracon希望获得雨林联盟认证。\n         </span>\n<span style=\"font-size: 14px;\">\n          虽然认证过程很长，但这是一个很好的方法来找出农场中的任何缺陷并解决它们。\n         </span>\n<br/>\n</p>\n<p style=\"text-align: center;margin-bottom: 0em;\">\n<br/>\n</p>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;margin-bottom: 0px;\">\n<span style=\"font-size: 14px;\">\n          Gera农场的供应链管理\n          <br/>\n</span>\n</section>\n<ul class=\"list-paddingleft-1\" style=\"list-style-type: circle;\">\n<li style=\"font-size: 14px;\">\n<section powered-by=\"werss\" style=\"line-height: 1.75em;\">\n<span style=\"font-size: 14px;\">\n            农场雇佣了70名固定工人来管理现在228公顷的咖啡种植\n           </span>\n</section>\n</li>\n<li style=\"font-size: 14px;\">\n<section powered-by=\"werss\" style=\"line-height: 1.75em;\">\n<span style=\"font-size: 14px;\">\n            咖啡鲜果采收送到农场后进行加工处理\n           </span>\n</section>\n</li>\n<li style=\"font-size: 14px;\">\n<section powered-by=\"werss\" style=\"line-height: 1.75em;\">\n<span style=\"font-size: 14px;\">\n            脱壳是在Tracon位于首都Addis的脱壳厂进行\n           </span>\n</section>\n</li>\n<li style=\"font-size: 14px;\">\n<section powered-by=\"werss\" style=\"line-height: 1.75em;\">\n<span style=\"font-size: 14px;\">\n            销售、物流管理也都由Tracon公司相关的部门与买家、航运、空运直接对接\n           </span>\n</section>\n</li>\n</ul>\n<p style=\"margin-bottom: 0px;\">\n<br/>\n</p>\n<section powered-by=\"werss\" style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;background-color: rgb(255, 255, 255);text-decoration-style: initial;text-decoration-color: initial;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<br/>\n</section>\n<section powered-by=\"werss\" style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-indent: 0px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;background-color: rgb(255, 255, 255);text-decoration-style: initial;text-decoration-color: initial;text-align: center;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;font-size: 14px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          更多咖啡豆选购，请关注收藏小程序和淘宝店铺哦～\n         </span>\n</section>\n<section powered-by=\"werss\" style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-indent: 0px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;background-color: rgb(255, 255, 255);text-decoration-style: initial;text-decoration-color: initial;text-align: center;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;font-size: 14px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          公众号的文章栏目有更多的咖啡信息\n          <br style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;\"/>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-indent: 0px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;background-color: rgb(255, 255, 255);text-decoration-style: initial;text-decoration-color: initial;text-align: center;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7Q09FO8svc4MbsT6kYe0icjVt0iafAKEvQb4V0sg5ELeaSJuChicNO6jr9zxGVFVu7wDwt3ibVQgXa5ow/640?wx_fmt=png\" style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;height: auto !important;width: 431px !important;visibility: visible !important;\"/>\n</section>\n</div>",
