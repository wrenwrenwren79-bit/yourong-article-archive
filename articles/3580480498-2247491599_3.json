yle='color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;margin-right: 8px;margin-left: 8px;outline: 0px;font-variant-ligatures: normal;visibility: visible;text-align: center;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/PWcq5eyxUTnBjDmS4d2xnZH4fictEERX1EMIIPuTCPS9Q97fObm6UANpicnaCL62GSEttQy6aLDrDUp1AucvcPUw/640?wx_fmt=jpeg&amp;wxfrom=13\" style='white-space: normal;outline: 0px;vertical-align: inherit;font-family: system-ui, -apple-system, system-ui, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-variant-ligatures: normal;orphans: 2;text-align: center;widows: 2;background-color: rgb(255, 255, 255);letter-spacing: 0.034em;width: 661px;visibility: visible !important;'/>\n<span style='outline: 0px;font-variant-ligatures: normal;letter-spacing: 0.544px;orphans: 2;text-align: center;widows: 2;background-color: rgb(255, 255, 255);color: rgb(136, 136, 136);font-size: 12px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;'>\n                    绿宝石庄园\n                   </span>\n<o:p style=\"outline: 0px;letter-spacing: 0.544px;\">\n</o:p>\n</p>\n<p style='color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;margin-right: 8px;margin-left: 8px;outline: 0px;font-variant-ligatures: normal;visibility: visible;'>\n<o:p style=\"outline: 0px;letter-spacing: 0.544px;\">\n</o:p>\n<o:p style=\"outline: 0px;letter-spacing: 0.544px;\">\n</o:p>\n</p>\n<section powered-by=\"werss\" style=\"color: rgb(0, 0, 0);font-family: Optima-Regular, PingFangTC-light;letter-spacing: 2px;line-height: 1.8em;text-align: justify;margin: 0px 8px;text-indent: 0em;\">\n<span style=\"color: rgb(34, 34, 34);font-size: 14px;letter-spacing: 2px;text-decoration: none;\">\n                    绿宝石\n                    <span style=\"caret-color: rgb(34, 34, 34);color: rgb(34, 34, 34);font-family: Optima-Regular, PingFangTC-light;font-size: 14px;letter-spacing: 2px;orphans: 2;widows: 2;background-color: rgb(255, 255, 255);\">\n                     由Norbey Quimbayo和他的妻子打理，\n                     <span style=\"caret-color: rgb(0, 0, 0);color: rgb(0, 0, 0);font-family: Optima-Regular, PingFangTC-light;font-size: 14px;letter-spacing: 2px;orphans: 2;text-indent: 8px;widows: 2;background-color: rgb(255, 255, 255);\">\n                      Norbey继承了父亲庄园后一开始他跟其它咖农一样生产商业咖啡，但2006年金融危机危机和咖啡价格下跌之后，利润开始逐渐下滑。Norbey决定到哥伦比亚咖啡学院研修，在那里他学习了很多不同的方法来改善他的咖啡品质，从而获得更高的收入和溢价。\n                     </span>\n</span>\n</span>\n</section>\n<p style=\"color: rgb(0, 0, 0);font-family: Optima-Regular, PingFangTC-light;letter-spacing: 2px;text-align: center;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7TMtZic4lguS5W1IOh4iamxWnGl57KvrIrF5vHWeUTkWJRKzSypLsicPCI0ozibfwWChhjUFbEggMzHxQ/640?wx_fmt=jpeg\"/>\n</p>\n<p style='color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;margin-right: 8px;margin-left: 8px;outline: 0px;font-variant-ligatures: normal;visibility: visible;'>\n<o:p style=\"outline: 0px;letter-spacing: 0.544px;\">\n</o:p>\n</p>\n<p style='color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;margin-right: 8px;margin-left: 8px;outline: 0px;font-variant-ligatures: normal;visibility: visible;'>\n<o:p style=\"outline: 0px;letter-spacing: 0.544px;\">\n</o:p>\n</p>\n<section powered-by=\"werss\" style=\"color: rgb(0, 0, 0);font-family: Optima-Regular, PingFangTC-light;letter-spacing: 2px;line-height: 1.8em;text-align: center;margin: 0px 8px 24px;text-indent: 0em;\">\n<span style=\"color: rgb(178, 178, 178);font-size: 12px;letter-spacing: 2px;text-decoration: none;\">\n                    庄园主Norbey Quimbayo\n                   </span>\n</section>\n<section powered-by=\"werss\" style='color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;margin-right: 8px;margin-left: 8px;outline: 0px;font-variant-ligatures: normal;visibility: visible;clear: both;min-height: 1em;text-align: left;line-height: 1.75em;margin-bottom: 0px;white-space: normal;orphans: 2;widows: 2;background-color: rgb(255, 255, 255);'>\n<span style=\"letter-spacing: 0.544px;\">\n                    关于处理\n                   </span>\n<br/>\n</section>\n<p style='color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;margin-right: 8px;margin-bottom: 0px;margin-left: 8px;outline: 0px;font-variant-ligatures: normal;orphans: 2;widows: 2;background-color: rgb(255, 255, 255);clear: both;min-height: 1em;text-align: left;visibility: visible;line-height: 1.75em;'>\n<span style=\"outline: 0px;font-family: Optima-Regular, PingFangTC-light;letter-spacing: 2px;text-align: justify;text-indent: 8px;visibility: visible;font-size: 14px;\">\n<span style=\"outline: 0px;font-family: Optima-Regular, PingFangTC-light;letter-spacing: 2px;text-align: justify;visibility: visible;\">\n<span style=\"outline: 0px;font-family: Optima-Regular, PingFangTC-light;letter-spacing: 2px;text-align: justify;visibility: visible;\">\n<span style=\"outline: 0px;font-family: Optima-Regular, PingFangTC-light;letter-spacing: 2px;text-align: justify;visibility: visible;\">\n<span style=\"color: rgb(0, 0, 0);font-family: Optima-Regular, PingFangTC-light;text-align: justify;visibility: visible;outline: 0px;font-size: 14px;letter-spacing: 0.544px;\">\n                        本批次的帕帕尤Norbey进行了蜜处理，咖啡鲜果采摘后随后会立刻进行浮选，去除漂浮在水上密度较低的有问题的鲜果。然后将咖啡进行脱皮，保留果胶，置于晾晒房晾晒25天，期间会每隔几小时就进行翻动，以保证发酵环境的温度及菌群的均衡。\n                       </span>\n</span>\n</span>\n</span>\n</span>\n</p>\n<p style='margin-right: 8px;margin-left: 8px;font-size: 14px;orphans: 2;text-indent: 8px;white-space: normal;widows: 2;color: rgb(34, 34, 34);font-family: system-ui, -apple-system, system-ui, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;outline: 0px;font-variant-ligatures: normal;text-align: left;visibility: visible;line-height: 1.75em;background-color: rgb(255, 255, 255);clear: both;min-height: 1em;margin-bottom: 0px;'>\n<br/>\n</p>\n<section powered-by=\"werss\" style='color: rgb(0, 0, 0);font-family: system-ui, -apple-system, system-ui, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;margin-right: 8px;margin-bottom: 0px;margin-left: 8px;outline: 0px;font-variant-ligatures: normal;orphans: 2;widows: 2;background-color: rgb(255, 255, 255);text-align: center;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/PWcq5eyxUTnBjDmS4d2xnZH4fictEERX10gdPXh8ibDqGdSHrTn3Rurf7fG1y4TIjQLfwARbg5ibgllUiak1Bkt1uQ/640?wx_fmt=jpeg&amp;wxfrom=5&amp;wx_lazy=1&amp;wx_co=1\" style=\"outline: 0px;vertical-align: inherit;letter-spacing: 0.034em;width: 661px;visibility: visible !important;\"/>\n<span style=\"text-indent: 8px;font-size: 14px;outline: 0px;color: rgb(0, 0, 0);font-family: Optima-Regular, PingFangTC-light;letter-spacing: 2px;text-align: justify;visibility: visible;\">\n<o:p style=\"outline: 0px;letter-spacing: 0.544px;\">\n</o:p>\n</span>\n<span style=\"color: rgb(0, 0, 0);outline: 0px;font-family: Optima-Regular, PingFangTC-light;letter-spacing: 2px;text-align: justify;text-indent: 8px;visibility: visible;font-size: 12px;\">\n<o:p style=\"outline: 0px;letter-spacing: 0.544px;\">\n</o:p>\n</span>\n<span style=\"outline: 0px;font-family: Optima-Regular, PingFangTC-light;letter-spacing: 2px;text-align: justify;text-indent: 8px;visibility: visible;font-size: 12px;color: rgb(178, 178, 178);\">\n<o:p style=\"outline: 0px;letter-spacing: 0.544px;\">\n                     庄园的鲜果池\n                    </o:p>\n</span>\n</section>\n<section powered-by=\"werss\" style='color: rgb(0, 0, 0);font-family: system-ui, -apple-system, system-ui, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;margin-right: 8px;margin-bottom: 0px;margin-left: 8px;outline: 0px;font-variant-ligatures: normal;orphans: 2;widows: 2;background-color: rgb(255, 255, 255);text-align: center;'>\n<span style=\"outline: 0px;font-family: Optima-Regular, PingFangTC-light;letter-spacing: 2px;text-align: justify;text-indent: 8px;visibility: visible;font-size: 12px;color: rgb(178, 178, 178);\">\n<o:p style=\"outline: 0px;letter-spacing: 0.544px;\">\n<br/>\n</o:p>\n</span>\n</section>\n<section powered-by=\"werss\" style='color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;margin-right: 8px;margin-left: 8px;outline: 0px;font-variant-ligatures: normal;visibility: visible;text-align: center;'>\n<o:p style=\"outline: 0px;letter-spacing: 0.544px;\">\n<span style=\"outline: 0px;font-family: Optima-Regular, PingFangTC-light;letter-spacing: 2px;visibility: visible;\">\n                     更多咖啡豆选购，请关注收藏小程序和淘宝店铺哦～\n                    </span>\n</o:p>\n</section>\n<section powered-by=\"werss\" style='color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;margin-right: 8px;margin-left: 8px;outline: 0px;font-variant-ligatures: normal;visibility: visible;text-align: center;'>\n<o:p style=\"outline: 0px;letter-spacing: 0.544px;\">\n<span style=\"outline: 0px;font-family: Optima-Regular, PingFangTC-light;letter-spacing: 2px;visibility: visible;\">\n                     公众号的文章栏目有更多的咖啡信息\n                    </span>\n</o:p>\n</section>\n<section powered-by=\"werss\" style='color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;margin-bottom: 0em;outline: 0px;font-variant-ligatures: normal;min-height: 1em;text-align: center;line-height: 1.75em;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7Q09FO8svc4MbsT6kYe0icjVt0iafAKEvQb4V0sg5ELeaSJuChicNO6jr9zxGVFVu7wDwt3ibVQgXa5ow/640?wx_fmt=png&amp;wxfrom=5&amp;wx_lazy=1&amp;wx_co=1\" style=\"outline: 0px;visibility: visible !important;width: 431px !important;\"/>\n</section>\n<p style='margin-right: 8px;margin-left: 8px;font-size: 14px;orphans: 2;text-indent: 8px;white-space: normal;widows: 2;color: rgb(34, 34, 34);font-family: system-ui, -apple-system, system-ui, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;outline: 0px;font-variant-ligatures: normal;text-align: left;visibility: visible;line-height: 1.75em;background-color: rgb(255, 255, 255);clear: both;min-height: 1em;margin-bottom: 0px;'>\n<br/>\n</p>\n</span>\n</section>\n</span>\n</section>\n</span>\n</section>\n</span>\n</section>\n</span>\n</secti