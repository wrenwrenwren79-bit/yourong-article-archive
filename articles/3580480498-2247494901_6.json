sform: scale(1, 0.5);'/>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;outline: 0px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;background-color: rgb(255, 255, 255);line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n<span>\n           这只咖啡来自Wate处理站，位于埃塞奥洛米亚州的古吉-罕贝拉-布库区域，\n          </span>\n<span style=\"outline: 0px;font-size: 14px;\">\n<span>\n            Sayisa是处理站周边生活的小部族Sayisa的名字，有近430户小农种植咖啡；它与我们之前每年都收买的Buku Sayisa来自同一区域，只是处理站有所区别；2025年埃塞ToH的第一名水洗也是来自于这个处理站；\n           </span>\n</span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7RvM858VJdfkCkCCia1GbSnpntuyNMhw8fiaVqsE3m7uhGr0wr6bZFllQNz1EJzvqd6sib9Ngqjhx3DA/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;outline: 0px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;background-color: rgb(255, 255, 255);line-height: 1.75em;text-align: center;'>\n<span style=\"font-size: 14px;\">\n<span style=\"color: rgb(178, 178, 178);font-size: 15px;letter-spacing: 0.544px;\">\n<span>\n<span style=\"font-size: 12px;\">\n             Wate河，也是处理站的名字来源\n            </span>\n</span>\n</span>\n<span style=\"color: rgb(178, 178, 178);font-size: 15px;letter-spacing: 0.544px;\">\n</span>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;outline: 0px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;background-color: rgb(255, 255, 255);line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n</span>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7RvM858VJdfkCkCCia1GbSnpib50EoicsxRcEIGOlMhlKcgCWLNg4uQg1lBroLvgMr9UEQnBJXqqJSbg/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7RvM858VJdfkCkCCia1GbSnpbASAgjKn8R3yHFdugnCHyNROFraHXjWhe9DeNEJcecicjpX5aEojnTg/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;outline: 0px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;background-color: rgb(255, 255, 255);line-height: 1.75em;text-align: center;'>\n<span style=\"font-size: 12px;color: rgb(178, 178, 178);\">\n<span>\n<br/>\n</span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"text-align: start;margin-bottom: 0px;white-space: normal;outline: 0px;letter-spacing: 0.544px;background-color: rgb(255, 255, 255);line-height: 1.75em;\">\n<span style=\"color:#272727;font-family:Avenir Next, sans-serif;\">\n<span style=\"caret-color: rgb(39, 39, 39);font-size: 14px;\">\n<span>\n            关于处理\n           </span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n             ‍\n            </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n             ‍\n            </span>\n</span>\n</span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"text-align: start;margin-bottom: 0px;white-space: normal;outline: 0px;letter-spacing: 0.544px;background-color: rgb(255, 255, 255);line-height: 1.75em;\">\n<section powered-by=\"werss\" style=\"text-align: start;margin-bottom: 0px;white-space: normal;outline: 0px;letter-spacing: 0.544px;background-color: rgb(255, 255, 255);line-height: 1.75em;\">\n<span style=\"color:#272727;font-family:Avenir Next, sans-serif;\">\n<span style=\"caret-color: rgb(39, 39, 39);font-size: 14px;\">\n<span>\n             产季里，下午3点到晚上8点处理站会从小农那里收集和验收咖啡鲜果，晚上9点到10点左右开始去皮，脱皮后加水浸泡发酵到早晨来去除果胶，然后搬运到到晒床上进行晾；\n            </span>\n</span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7RvM858VJdfkCkCCia1GbSnpBmatlRCnGvfKE4kOwNibSaibibEacwSbcL0BsiaAqKZ781WUDUia3yiaibZDA/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style=\"text-align: start;margin-bottom: 0px;white-space: normal;outline: 0px;letter-spacing: 0.544px;background-color: rgb(255, 255, 255);line-height: 1.75em;\">\n<span style=\"color:#272727;font-family:Avenir Next, sans-serif;\">\n<span style=\"caret-color: rgb(39, 39, 39);font-size: 14px;\">\n<span>\n<br/>\n</span>\n</span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"text-align: start;margin-bottom: 0px;white-space: normal;outline: 0px;letter-spacing: 0.544px;background-color: rgb(255, 255, 255);line-height: 1.75em;\">\n<span style=\"color:#272727;font-family:Avenir Next, sans-serif;\">\n<span style=\"caret-color: rgb(39, 39, 39);font-size: 14px;\">\n<span>\n             晾晒过程中，每天在下午12点到3点之间，咖啡床会被盖起来，这样阳光就不会直射到咖啡豆上；每天搅拌4次来保证均匀的干燥，含水率到11.5左右时，收储放到仓库静置。\n            </span>\n</span>\n</span>\n</section>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;outline: 0px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;background-color: rgb(255, 255, 255);line-height: 1.75em;'>\n<span>\n<br/>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0em;outline: 0px;font-family: \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;white-space: normal;letter-spacing: 0.544px;color: rgb(34, 34, 34);background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;visibility: visible;'>\n<span style='outline: 0px;font-size: 14px;font-family: \"PingFang SC\", -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;'>\n<span>\n           众号的文章栏目有更多的咖啡信息\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;white-space: normal;letter-spacing: 0.544px;color: rgb(34, 34, 34);font-family: \"PingFang SC\", -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;'>\n<span style='outline: 0px;font-family: \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;'>\n<span>\n           客服微信：sabh_lt （售前/售后/加群）\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;font-family: \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;white-space: normal;letter-spacing: 0.544px;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7RicESSboT2yAGicv25eicYwA9eYTVnj6tnDXYWHJ5amUjBqzNK6pdB5dhozgCKLqOuf9IgicGe5pVLibQ/640?wx_fmt=other&amp;wxfrom=10005&amp;wx_lazy=1&amp;wx_co=1&amp;tp=webp\" style=\"outline: 0px;caret-color: rgb(0, 0, 0);color: rgb(0, 0, 0);letter-spacing: normal;text-align: start;visibility: visible !important;width: 578px !important;\"/>\n</section>\n<p style=\"display: none;\">\n<mp-style-type data-value=\"3\">\n</mp-style-type>\n</p>\n</div>",
