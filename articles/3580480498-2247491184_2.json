Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"font-size: 14px;\">\n          采收处理：2022年8月\n         </span>\n</p>\n<p style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"font-size: 14px;\">\n          海运到港：2023年1月\n          <span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n</span>\n</p>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;text-align: justify;margin: 0px;text-indent: 0em;\">\n<span style=\"color: rgb(51, 51, 51);font-size: 14px;letter-spacing: 0.544px;text-decoration: none solid rgb(51, 51, 51);\">\n          风味：橙子、覆盆子、菇娘果\n         </span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;text-align: justify;margin: 0px;text-indent: 0em;\">\n<span style=\"color: rgb(51, 51, 51);font-size: 14px;letter-spacing: 0.544px;text-decoration: none solid rgb(51, 51, 51);\">\n          Orange, Raspberry, Golden berry\n         </span>\n</section>\n<p style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;font-size: 14px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n</span>\n</p>\n<p style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<strong>\n<span style=\"font-size: 14px;letter-spacing: 0.544px;\">\n           品种：帕帕尤 Papayo\n          </span>\n</strong>\n<br/>\n</p>\n<p style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"font-size: 14px;\">\n          处理方式：日晒 Natural\n         </span>\n</p>\n<p style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"font-size: 14px;\">\n          采收处理：2022年12月\n          <br/>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n</span>\n</p>\n<p style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"font-size: 14px;\">\n          海运到港：2023年4月\n          <span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n</span>\n</p>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;text-align: justify;margin: 0px;text-indent: 0em;\">\n<span style=\"color: rgb(51, 51, 51);font-size: 14px;letter-spacing: 0.544px;text-decoration: none solid rgb(51, 51, 51);\">\n          风味：树莓、蔓越莓、蓝莓\n          <span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;text-align: justify;margin: 0px;text-indent: 0em;\">\n<span style=\"color: rgb(51, 51, 51);font-size: 14px;letter-spacing: 0.544px;text-decoration: none solid rgb(51, 51, 51);\">\n          Raspberry, Cranberry, Blueberry\n         </span>\n</section>\n<p style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"font-size: 14px;\">\n</span>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7TWPEXxn88NbEX8jW31ibicxlibHdoEULvMxNyHrPPR3dynYHVItkoXv4YBA1k9LvV46zSkEMiaMIAEFQ/640?wx_fmt=jpeg\" style=\"letter-spacing: 0.544px;text-align: center;outline: 0px;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible !important;width: 578px !important;\"/>\n</p>\n<p style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);text-align: center;visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"font-size: 14px;\">\n<strong>\n           以下文字内容由咖篮提供\n          </strong>\n</span>\n<br style=\"outline: 0px;max-width: 100%;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;\"/>\n</p>\n<p style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;font-size: 14px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n<strong style=\"outline: 0px;max-width: 100%;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n           庄园介绍\n          </strong>\n</span>\n</p>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;\">\n<span style='outline: 0px;max-width: 100%;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n          塔玛娜庄园是挪威烘焙大师Tim Wendelboe一直在哥伦比亚密切合作的项目。塔玛娜庄园位于慧兰省El Pital附近的山区，这里的气候十分多变，几乎每天都有阵雨。该地区出产的咖啡特点是明亮柠檬酸、丰富的浆果味和多汁的口感。然而，由于大多数庄园的面积都在2公顷左右，而且咖农很难进行高品质的采摘和加工，所以很难从这个地区找到足够多的高品质的精品批次。而塔玛娜庄园面积多达60公顷，在当地是非常难得的项目，可以进行大规模的生产，并从源头开始把控品质。\n         </span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7Q060nAPicF6E9OYxIDJCQqz7N6dOHBZibqMsQiateibAIGUmsaDBpiaick3lQ2LrVOyZlf6LBH07BhHiapA/640?wx_fmt=jpeg\" style=\"white-space: normal;\"/>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;\">\n<span style='outline: 0px;max-width: 100%;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n          塔玛娜庄园在和Tim合作之后，做出了以下改进：在交付和处理之前细化了所有咖啡鲜果的采摘和分级；改进并清洁发酵和水洗过程，确保咖啡的干净度；在阴凉处晾晒咖啡以改进干燥过程，这有助于让咖啡更长时间地保持新鲜。每天的采摘工作按照品种细分，每天采摘单一品种，经过加工、干燥，分开保存。我们将努力改进这个农场的咖啡，并使农场更加可持续化并且自给自足。\n         </span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<br/>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;font-size: 14px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n<strong style=\"outline: 0px;max-width: 100%;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n           塔玛娜庄园的种植管理\n          </strong>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;\">\n<span style='outline: 0px;max-width: 100%;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"font-size: 14px;letter-spacing: 0.544px;background-color: rgb(255, 255, 255);\">\n           塔玛娜庄园分成不同的地块种植管理。从鲜果采摘开始，庄园主Elias要求采摘工每天只采摘成熟的鲜果。鲜果被交至湿处理站的时候，马上会浸入水池中，将密度较低浮在水面的咖啡捞掉，然后在桌面上进行鲜果手选。这一步骤也是塔玛娜生产优质精品咖啡的关键，虽然看起来增加了很多成本。工人们会挑选出对品质有害无益的过度成熟鲜果。这种对细节的额外处理自然为Elias的工人们带来额外回报，塔玛娜庄园的采摘工工资比该地区大多数采摘工高出50%以上。\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;\">\n<span style='outline: 0px;max-width: 100%;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7Q060nAPicF6E9OYxIDJCQqzno2q999t1RpeyttYhjw70qDkz3SeESNoQEWXzZq4hPpoS40ibbmsOyQ/640?wx_fmt=jpeg\" style=\"white-space: normal;\"/>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;\">\n<span style='outline: 0px;max-width: 100%;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<br/>\n</span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;font-size: 14px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n<strong style=\"outline: 0px;max-width: 100%;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n           塔玛娜庄园的水洗处理\n          </strong>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-right: 8px;margin-left: 8px;outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);text-align: left;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style='outline: 0px;max-width: 100%;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n          在收获的当天进行鲜果脱皮，并无水发酵12小时，然后进行湿发酵。Elias充分利用从距离处理站250米处涌出的天然泉水，将咖啡清洗四次，不断地搅拌咖啡豆并捞走任何经过此阶段仍然漂浮起的咖啡豆和果肉，最后将咖啡留在清水中静置12小时，每4小时换一次水，保持清洁。\n         </span>\n</section>\n<section powered-by=\"werss\" style='margin-right: 8px;margin-left: 8px;outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);text-align: left;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style='outline: 0px;max-width: 100%;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n          缓慢晾晒干燥是优质精品咖啡保证质量和风味期的关键。完成清洗后，咖啡将放在晒床上进行24小时的露天干燥，然后转移到干燥房，这里设有温度监测，利用两侧的通风装置，使一天之内的干燥房气温保持在20到30摄氏度之间。水洗咖啡豆理想干燥时间为20天，但在潮湿的天气，最多可干燥30天，正是这种长时间的干燥使咖啡的风味期得以持久。\n         </span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;\">\n<span style='outline: 0px;max-width: 100%;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7Q060nAPicF6E9OYxIDJCQqzaTeema3iclpgsho0PtDy59ibJps7rXzoibhics9xLgSE7T21Cice601Lh8A/640?wx_fmt=jpeg\" style=\"white-space: normal;width: 578px;height: 778px;\"/>\n</span>\n<span style='color: rgb(0, 0, 0);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;text-align: center;background-color: rgb(255, 255, 255);'>\n          在塔玛娜现有的60余公顷土地中，目前只有20公顷在生产咖啡。然而，Elias计划逐年开辟更多土地种植咖啡，如果他实现了这个目标，他将再建造多达10个干燥房，以应对每个采摘者每日采摘下来的鲜果处理。Elias正在制定长期战略计划，并认为现在的辛勤工作终将获得回报。现在塔玛娜正在采取的一些看似复杂的措施正在显著地提高咖啡的品质，尽管前方还有很长的路要走，需要进一步改善基础设施。Elias承诺，会不断进行改进，使每一年的咖啡越来越好。\n         </span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;\">\n<span style='color: rgb(0, 0, 0);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;text-align: center;background-color: rgb(255, 255, 255);'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7Q060nAPicF6E9OYxIDJCQqzVSmFa0gB7mJ3faEGyB5ib3lUu4xE159KhEBPNtZSDWjeUF1K4OVpgUw/640?wx_fmt=jpeg\" style=\"white-space: normal;width: 578px;height: 738px;\"/>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;\">\n<span style='color: rgb(0, 0, 0);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;text-align: center;background-color: rgb(255, 255, 255);'>\n          Tim Wendelboe与Tamana的故事\n         </span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);text-align: left;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;text-align: center;color: rgb(0, 0, 0);font-size: 14px;letter-spacing: 0.544px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          “我第一次见到Elias是在2007年，当时我和我的朋友并且也是我们的咖啡出口商在哥伦比亚旅行。这次旅行的目的是寻找潜在的可以与我合作的咖农，以确保我们从哥伦比亚获得稳定且高品质的咖啡供应。在经过慧兰时，我拜访了Elias领导的阿塞韦多的一小群咖农。我记得我们在他家喝了热巧，吃了面包和奶酪，Elias给我的印象是一个充满激情和勤奋的咖农。那年稍晚几个月，我就收到了他的一些样品，但不幸的是，他的咖啡当时并不符合我的质量要求，所以当时没有进行采购。\n         </span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);text-align: left;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;text-align: center;color: rgb(0, 0, 0);font-size: 14px;letter-spacing: 0.544px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          在我后来再到哥伦比亚时，我们又见了几次面，但直到2011年我们才开始讨论一起合作的可能性。有几个原因激发了我与Elias合作的兴趣。每次我去哥伦比亚时，他都表现出想与我见面的热情，他还买下了塔玛娜庄园，它恰好位于一个我一直采购的庄园旁边。这意味着我知道这里有种植优质咖啡的潜力，而且由于塔玛娜庄园比哥伦比亚平均2公顷面积的咖啡庄园大得多，我知道这里有潜力生产足够优质的咖啡来满足我们的需求。\n         </span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;text-align: center;color: rgb(0, 0, 0);font-size: 14px;letter-spacing: 0.544px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          然后我们遇到了最大的挑战，Elias没有足够的钱了，农场几乎没有处理的基础设施，而且他在如何生产高品质的咖啡方面经验\n         </span>\n<span style=\"outline: 0px;max-width: 100%;text-align: center;color: rgb(0, 0, 0);font-size: 14px;letter-spacing: 0.544px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          甚少。好消息是，咖啡树已经结满了果实，Elias是一个有梦想的人，并且有着开放的心态和勇气。他愿意和我一起做一些实验项目，所以在2012年6月，我回到他的农场并呆了一个星期，一起商量如何改进塔玛娜庄园的咖啡品质。\n         </span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);text-align: left;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;text-align: center;color: rgb(0, 0, 0);font-size: 14px;letter-spacing: 0.544px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          这标志着美好友谊和合作关系的开始。”\n         </span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);text-align: left;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;text-align: center;color: rgb(0, 0, 0);font-size: 14px;letter-spacing: 0.544px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7Q060nAPicF6E9OYxIDJCQqzichYGuYYQAT0iaZeoyjfUy2Wkn9W74ibM6tiaS9N0YQgh4WfIrWX4JnTLw/640?wx_fmt=jpeg\" style=\"white-space: normal;width: 578px;height: 545px;\"/>\n</span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;text-align: center;color: rgb(0, 0, 0);font-size: 14px;letter-spacing: 0.544px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          自从与Elias开始合作以来，我们进行了各种各样的改进，但所有这些都基于我们在2012年制定的长期计划。我们想让塔玛娜成为一个能够持续性生产高品质精品咖啡的庄园，并减少其对环境的负面影响。\n         </span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;text-align: center;color: rgb(0, 0, 0);font-size: 14px;letter-spacing: 0.544px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          为了实现这一目标，我们还需要确保Elias生产咖啡的资金方面没有困难。这就是为什么一开始我们要专注于最关键的步骤，以使质量更好、更稳定，从而提高咖啡的附加价值。\n         </span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;text-align: center;color: rgb(0, 0, 0);font-size: 14px;letter-spacing: 0.544px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          我们开始做的第一件事就是把咖啡按品种分开，以确定哪种咖啡最适合这里生长。然后我们专注于改进庄园咖啡果的采摘、处理和晾晒。但是，确保只用一定成熟度的鲜果来进行加工看似简单——这对于生产美味高品质的咖啡至关重要，但结果证明这是相当具有挑战性的。咖啡为季节性成熟，非全职的咖啡采摘工似乎不愿意这样做，即使承诺每公斤采摘鲜果的工钱会更高，他们仍然不愿意改变自己的工作方式。直到他们收到第一笔工钱，当他们看到通过拣选成熟果最终能赚到更多钱时，大多数工人才认可了这套要求。\n         </span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;text-align: center;color: rgb(0, 0, 0);font-size: 14px;letter-spacing: 0.544px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          我们还为处理厂设定了更规范化的处理标准。不是全天对咖啡进行脱皮，而是仅在晚上对咖啡进行脱皮，并定时检查发酵状态，直到咖啡发酵完成。我们采用了一个更好的办法来去除浮豆（密度较低且质量不好的豆子）并清洗咖啡。\n         </span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;text-align: center;color: rgb(0, 0, 0);font-size: 14px;letter-spacing: 0.544px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          新的处理框架意味着Elias必须向采摘者支付更多工钱，处理过程还需要增加24小时，而咖啡的干燥时间需要长达30天，而不是传统的6到8天。我们还改进了咖啡在干燥后的储存方式，并研究了如何改进物流、分拣和包装，以延长咖啡的保质期并在咖啡收获、加工和干燥后保持其品质的稳定性。\n         </span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7Q060nAPicF6E9OYxIDJCQqzl6O9B8aleV45o42icicet2BqqemMBsWkV8t2rjEL4xBtDKQLabP7Jiaxw/640?wx_fmt=jpeg\"/>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;\">\n<br/>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;text-align: center;color: rgb(0, 0, 0);font-size: 14px;letter-spacing: 0.544px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          “在加工和干燥过程中增加大量额外的时间意味着Elias必须投资基础设施并扩大生产设施。自2012年以来，他为自己和家人建造了一座新房子，为季节性工作的采摘工人建造了一个新宿舍，以及一个大厨房，他的妻子Bellanid每天在那里为他的家人和农场的工人准备餐食。2012年以来农场已经先后增加了若干部处理设备，至少节约了50倍的处理用水。\n         </span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;text-align: center;color: rgb(0, 0, 0);font-size: 14px;letter-spacing: 0.544px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          但基础设施并不是我们唯一关注的事情。Elias还获得了更好的农业技术支持，以确保他的咖啡树生长良好。他已经停止使用除草剂，现在会定期修剪杂草，这意味着土壤会逐渐变得更好，因为有机物质的积累又被分解成肥料。我们还鼓励和支持他种植更多的遮荫树，为全球变暖的气候做准备，因为我们相信最好的咖啡总是在原生树木的自然遮荫下生长。\n         </span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;text-align: center;color: rgb(0, 0, 0);font-size: 14px;letter-spacing: 0.544px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          尽管到目前为止所有的改进对于提高咖啡品质都很重要，但我们认为这只是一个开始而已。根据我的经验，影响咖啡风味的最大因素是咖啡植物本身。这就是为什么我们在塔玛娜庄园种植了30多种不同的咖啡品种，来看看是否有一些品种可以生产出比传统品种（Caturra和Colombia）更好的品质。到目前为止，我们已经成功地小规模生产了著名的肯尼亚SL28品种，该品种具有更明显的果味，最近Elias还收获了一些其他品种Papayo, Etiope等的鲜果，这些品种的味道也非常好。\n         </span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;text-align: center;color: rgb(0, 0, 0);font-size: 14px;letter-spacing: 0.544px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          他还生产不同类型的卡斯蒂略，还有铁皮卡，很快我们将能够从即将开始生产的品种中发现一些令人惊叹的新味道。在庄园开发一种新的品种并投入生产可能需要5到10年的时间，并且不能保证一定会成功。尽管如此，从这些新品种中品尝的味道来看，我觉得还是很有未来的，我个人相信塔玛娜庄园将在不久的将来生产出一些美味而稀有的咖啡。”\n         </span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<br/>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);text-align: right;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;text-align: center;color: rgb(0, 0, 0);font-size: 14px;letter-spacing: 0.544px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          ——以上内容摘录编译自Tim Wendelboe官方网站\n         </span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<br/>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;font-size: 14px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          公众号的文章板块有豆子信息\n         </span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"outline: 0px;max-width: 100%;font-size: 14px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          淘宝店铺和有赞小程序可选购更多豆子～\n         </span>\n</section>\n<section powered-by=\"werss\" style='outline: 0px;max-width: 100%;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7Q09FO8svc4MbsT6kYe0icjVt0iafAKEvQb4V0sg5ELeaSJuChicNO6jr9zxGVFVu7wDwt3ibVQgXa5ow/640?wx_fmt=png\" style=\"outline: 0px;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible !important;width: 388px !important;\"/>\n</section>\n<p style=\"display: none;\">\n<mp-style-type data-value=\"10000\">\n</mp-style-type>\n</p>\n</div>",
