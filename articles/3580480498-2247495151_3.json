no Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n           ‍\n          </span>\n</span>\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n           ‍\n          </span>\n</span>\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n           ‍\n          </span>\n</span>\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n           ‍\n          </span>\n</span>\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n           ‍\n          </span>\n</span>\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n           ‍\n          </span>\n</span>\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n           ‍\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\">\n<p style=\"margin-top: 0px;margin-bottom: 0px;line-height: 1.75em;\">\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n            入口很深色莓果 ，酸感很扎实，不是那种很强的，但是时很持久，嘴巴里像吃到的李子蔓越莓桑葚一起的感受，甜感也很饱满，尾韵还有一些果干和可可，挺好的；\n           </span>\n</span>\n</p>\n<section powered-by=\"werss\">\n<span style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;caret-color: rgb(171, 25, 66);color: rgb(0, 0, 0);font-family: Calibri, sans-serif;font-size: 14px;font-style: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration: none;text-align: left;\">\n           特征关键词：\n          </span>\n<span style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;caret-color: rgb(171, 25, 66);color: rgb(0, 0, 0);font-family: Calibri, sans-serif;font-size: 14px;font-style: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration: none;line-height: 1.75em;text-align: left;\">\n<span style=\"color: rgb(171, 25, 66);font-weight: bold;\">\n            深色核果莓果+红色莓果+果干+可可\n           </span>\n</span>\n</section>\n<p style=\"margin-top: 0px;margin-bottom: 0px;line-height: 1.75em;\">\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<br/>\n</span>\n</p>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;margin-bottom: 0px;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7TLo0tSq2ticraTgN2oI2U6ib17sar3bfsI1eD5nlS8EYZXeMh9QE7GU8HOJ1ckqM7oe6OCKibXexXuw/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;margin-bottom: 0px;\">\n<span style=\"font-size: 12px;\">\n<span>\n           新塞哥维亚省在上图的12点位置\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7SkB6M2kMYzk2Ea1BO4eOlajZ0qxia4sy1AmyTOCTwWo9icdSZb4AR6NO727rjxvdCVMQicHCBKdOONg/640?wx_fmt=png&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7SkB6M2kMYzk2Ea1BO4eOlaO8st3wWJAg8NrbKv0ymTtX1xo0yeJBml4nzPibBlPff0RqafqOu42FQ/640?wx_fmt=png&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;'>\n<strong style=\"outline: 0px;\">\n<span style=\"outline: 0px;font-size: 14px;\">\n<span>\n            关\n           </span>\n<span style='letter-spacing: 0.544px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;font-weight: bold;outline: 0px;font-size: 14px;'>\n            于\n           </span>\n<span style='letter-spacing: 0.544px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;font-weight: bold;outline: 0px;font-size: 14px;'>\n            Brisas del Mogotón\n           </span>\n<span style='letter-spacing: 0.544px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;font-weight: bold;outline: 0px;font-size: 14px;'>\n</span>\n<span style='letter-spacing: 0.544px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;font-weight: bold;outline: 0px;font-size: 14px;'>\n            莫戈\n           </span>\n<span>\n            顿微风庄园\n           </span>\n</span>\n</strong>\n</section>\n<section powered-by=\"werss\" style=\"margin-bottom: 0px;margin-top: 0px;line-height: 1.75em;\">\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n           莫戈顿微风庄园（Brisas del Mogotón）是一座家族农场，坐落于尼加拉瓜新塞哥维亚省圣费尔南多市拉乌尼昂地区。庄园由希门尼斯家族经营管理，海拔高度1,500米，总面积210公顷，其中30公顷用于咖啡种植，其余土地致力于动植物物种保护，践行对可持续发展和环境保护的承诺。\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7QiazibXUzibS0EQtfFZa6h8Hz04b1RZb7uQYHfmQ6cWWsCZf1ooUzfUmoAFAQs7e7lonoF7YCibPHeFg/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style=\"margin-bottom: 0px;margin-top: 0px;line-height: 1.75em;\">\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n           这座庄园由\n          </span>\n</span>\n<span>\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n            Mauricio的祖\n           </span>\n</span>\n<span style='line-height: 1.75em;color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n            父Mauricio Antonio Jiménez López于1996年购得。十年后的2006年，由\n           </span>\n</span>\n<span style='line-height: 1.75em;color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n            Jiménez Rodríguez家族继\n           </span>\n</span>\n<span style='line-height: 1.75em;color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n            承，如今第三代传人延续着这份咖啡种植传统。\n           </span>\n</span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7QiazibXUzibS0EQtfFZa6h8Hzjkoiciat3q81KCORjtiaa7Bibhjdiasy3eFP7PPCiceQUVUWXdgMncPBwemw/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7QiazibXUzibS0EQtfFZa6h8HzeojKOviaZLIVRUZjXm1oWrASBkamduUAccWq1JXwWxFZkWPrBNeGiaIA/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;line-height: 1.75em;text-align: center;'>\n<span style='outline: 0px;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;background-color: rgb(255, 255, 255);'>\n<span>\n           更多咖啡豆选购，请关注淘宝店铺哦～\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n<span>\n           公众号的文章栏目有更多的咖啡信息\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;'>\n<span style='outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;'>\n<span>\n           客服微信：sabh_lt （售前/售后/加群）\n           <img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7RicESSboT2yAGicv25eicYwA9eYTVnj6tnDXYWHJ5amUjBqzNK6pdB5dhozgCKLqOuf9IgicGe5pVLibQ/640?wx_fmt=other&amp;wxfrom=10005&amp;wx_lazy=1&amp;wx_co=1&amp;tp=webp\" style=\"outline: 0px;letter-spacing: normal;text-align: start;font-size: 17px;caret-color: rgb(0, 0, 0);color: rgb(0, 0, 0);visibility: visible !important;width: 578px !important;\"/>\n</span>\n</span>\n</section>\n<section powered-by=\"werss\">\n<span>\n<br/>\n</span>\n</section>\n<p style=\"display: none;\">\n<mp-style-type data-value=\"3\">\n</mp-style-type>\n</p>\n</div>",
