style='margin-bottom: 0em;outline: 0px;font-family: \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;background-color: rgb(255, 255, 255);line-height: 1.75em;visibility: visible;'>\n<span style=\"outline: 0px;color: rgb(0, 0, 0);font-family: Calibri, sans-serif;font-size: 14px;\">\n<span>\n<br/>\n</span>\n</span>\n</p>\n<p style='margin-bottom: 0em;outline: 0px;letter-spacing: 0.544px;white-space: normal;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;visibility: visible;'>\n<span>\n<img src=\"https://mmbiz.qpic.cn/mmbiz_png/Gr457cyFia7Tia6593icv0lvf4dHREGOfbmAfP622IA0ctib7XLruCiaic1fylcq16UlTRsAfTqJ7ic2yrts31yszWxsw/640?wx_fmt=other&amp;wxfrom=10005&amp;wx_lazy=1&amp;wx_co=1&amp;tp=webp\" style=\"outline: 0px;letter-spacing: 0.544px;text-align: center;width: 677px !important;visibility: visible !important;\"/>\n</span>\n<span>\n<br/>\n</span>\n</p>\n<p style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;'>\n<span style=\"outline: 0px;color: rgb(178, 178, 178);font-size: 14px;letter-spacing: 0.544px;\">\n<span>\n           图片来源\n          </span>\n</span>\n<span>\n<a class=\"normal_text_link\" data-linktype=\"2\" href=\"https://www.cafeimports.com/europe/ecuador\" linktype=\"text\" style=\"outline: 0px;color: rgb(87, 107, 149);cursor: pointer;font-size: 14px;letter-spacing: 0.544px;\" target=\"_blank\" textvalue=\"\">\n           CAFE IMPORT\n          </a>\n</span>\n</p>\n<p style='margin-bottom: 0px;outline: 0px;font-family: \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;text-align: center;'>\n<span style=\"outline: 0px;font-size: 12px;letter-spacing: 0.544px;\">\n<span>\n           Pichincha位于地图上北部，褐色区块，Imbabura下方\n          </span>\n</span>\n</p>\n<p style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);'>\n<span style=\"outline: 0px;font-size: 14px;\">\n<strong style=\"outline: 0px;\">\n<span>\n            关于养豆、储存和冲煮\n           </span>\n</strong>\n</span>\n</p>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;font-family: \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7SkB6M2kMYzk2Ea1BO4eOlaO8st3wWJAg8NrbKv0ymTtX1xo0yeJBml4nzPibBlPff0RqafqOu42FQ/640?wx_fmt=other&amp;from=appmsg&amp;wxfrom=10005&amp;wx_lazy=1&amp;wx_co=1&amp;tp=webp\" style=\"outline: 0px;visibility: visible !important;width: 677px !important;\"/>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;font-family: \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7SkB6M2kMYzk2Ea1BO4eOlajZ0qxia4sy1AmyTOCTwWo9icdSZb4AR6NO727rjxvdCVMQicHCBKdOONg/640?wx_fmt=other&amp;from=appmsg&amp;wxfrom=10005&amp;wx_lazy=1&amp;wx_co=1&amp;tp=webp\" style=\"outline: 0px;visibility: visible !important;width: 677px !important;\"/>\n</section>\n<p style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);'>\n<span style=\"outline: 0px;font-size: 14px;\">\n<strong style=\"outline: 0px;\">\n<span>\n<br/>\n</span>\n</strong>\n</span>\n</p>\n<p style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);'>\n<strong style=\"outline: 0px;\">\n<span style=\"outline: 0px;font-size: 14px;\">\n<span>\n            关于\n           </span>\n<span style=\"font-size: 14px;letter-spacing: 0.476px;\">\n<span>\n             十字山农场\n            </span>\n</span>\n</span>\n</strong>\n</p>\n<hr style='outline: 0px;letter-spacing: 0.544px;white-space: normal;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);border-right-width: 0px;border-style: solid;border-color: rgba(0, 0, 0, 0.1);border-bottom-width: 0px;border-left-width: 0px;transform: scale(1, 0.5);transform-origin: 0px 0px;'/>\n<p>\n<span style=\"font-size: 14px;letter-spacing: 0.034em;\">\n<span>\n           Cruz Loma (十字山农场) 是一家家族经营的屡获殊荣的咖啡农场，已有20多年生产咖啡的历史。但直到最近6年，他们才开始专注于精品咖啡。\n          </span>\n</span>\n</p>\n<section powered-by=\"werss\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7SR9xz1aMKg8q8OicuvPONX45JBqqFpNZzwc6X8LggmOFaRVoq1JhxicVBXoqdwf8Uia5ue5V1fgAMicA/640?wx_fmt=webp&amp;from=appmsg\"/>\n</section>\n<p>\n<span style=\"font-size: 14px;letter-spacing: 0.034em;\">\n<span>\n           加洛·莫拉莱斯（Galo Morales）曾在咖啡贸易公司工作，在那里他获得了宝贵的经验，而现在专注于他的咖啡和农场。和他的妻子玛丽亚·亚历山德拉一起，他们在厄瓜多尔经营着自己的开创性庄园！\n          </span>\n</span>\n<span>\n<br/>\n</span>\n</p>\n<section powered-by=\"werss\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7SR9xz1aMKg8q8OicuvPONX4CQQh39sdoGqUyNviaesw0ibDDWvG3kDaltwYDAJtgSyZfc5MGcjeMiaWA/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7SR9xz1aMKg8q8OicuvPONX44XNSAibCQa3ic0MhdbbRa2ficsfabnLJpVQjgMblAw9MvfnicYZpjv8ysA/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<p>\n<span style=\"font-size: 14px;letter-spacing: 0.034em;\">\n<span>\n           Cruz Loma因其对精品咖啡的努力和贡献也获得了优异的回报。2022年与2023年荣获COE第三名，2021年荣获最佳厄瓜多尔第一名；\n          </span>\n</span>\n<span>\n<br/>\n</span>\n</p>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7SR9xz1aMKg8q8OicuvPONX4Ym5bJicQJpumho9DIGY14QpXJ0RlGU9BVj6a6ezicRib9BTGTNwX9ew9A/640?wx_fmt=png&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0em;outline: 0px;letter-spacing: 0.544px;white-space: normal;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;color: rgb(34, 34, 34);background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;visibility: visible;'>\n<span style='outline: 0px;font-size: 14px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;'>\n<span>\n           公众号的文章栏目有更多的咖啡信息\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;'>\n<span style='outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;'>\n<span>\n           客服微信：sabh_lt （售前/售后/加群）\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7RicESSboT2yAGicv25eicYwA9eYTVnj6tnDXYWHJ5amUjBqzNK6pdB5dhozgCKLqOuf9IgicGe5pVLibQ/640?wx_fmt=other&amp;wxfrom=10005&amp;wx_lazy=1&amp;wx_co=1&amp;tp=webp\" style=\"outline: 0px;caret-color: rgb(0, 0, 0);color: rgb(0, 0, 0);letter-spacing: normal;text-align: start;visibility: visible !important;width: 578px !important;\"/>\n</section>\n<p style=\"display: none;\">\n<mp-style-type data-value=\"3\">\n</mp-style-type>\n</p>\n</div>",
