mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n           ‍\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"margin-top: 0px;margin-bottom: 0px;line-height: 1.75em;\">\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;color: rgb(255, 41, 65);font-weight: bold;\">\n           特征关键词：黄色柑橘+核果+红茶感\n          </span>\n</span>\n</section>\n<p style=\"margin-top: 0px;margin-bottom: 0px;line-height: 1.75em;\">\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<img src=\"https://mmbiz.qpic.cn/mmbiz_png/Gr457cyFia7Tia6593icv0lvf4dHREGOfbmAfP622IA0ctib7XLruCiaic1fylcq16UlTRsAfTqJ7ic2yrts31yszWxsw/640?wx_fmt=other&amp;wxfrom=10005&amp;wx_lazy=1&amp;wx_co=1&amp;tp=webp\" style=\"outline: 0px;letter-spacing: 0.544px;text-align: center;width: 677px !important;visibility: visible !important;\"/>\n</span>\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<br/>\n</span>\n</p>\n<p style=\"margin-top: 0px;margin-bottom: 0px;line-height: 1.75em;text-align: center;\">\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 12px;\">\n           图片来源\n          </span>\n</span>\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<a class=\"normal_text_link\" data-linktype=\"2\" href=\"https://www.cafeimports.com/europe/ecuador\" linktype=\"text\" style=\"outline: 0px;color: rgb(87, 107, 149);cursor: pointer;font-size: 14px;letter-spacing: 0.544px;\" target=\"_blank\" textvalue=\"\">\n<span style=\"font-size: 12px;\">\n            CAFE IMPORT\n           </span>\n</a>\n</span>\n</p>\n<p style=\"margin-top: 0px;margin-bottom: 0px;line-height: 1.75em;text-align: center;\">\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 12px;\">\n           Pichincha位于地图上北部，褐色区块，Imbabura下方\n          </span>\n</span>\n</p>\n<p style=\"margin-top: 0px;margin-bottom: 0px;line-height: 1.75em;\">\n<strong>\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<br/>\n</span>\n</strong>\n</p>\n<p style=\"margin-top: 0px;margin-bottom: 0px;line-height: 1.75em;\">\n<strong>\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;font-weight: bold;\">\n            关于养豆、储存和冲煮\n           </span>\n</span>\n</strong>\n</p>\n<section powered-by=\"werss\" style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;line-height: 1.75em;letter-spacing: 0.034em;font-style: normal;font-weight: normal;margin-top: 0px;margin-bottom: 0px;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7SkB6M2kMYzk2Ea1BO4eOlaO8st3wWJAg8NrbKv0ymTtX1xo0yeJBml4nzPibBlPff0RqafqOu42FQ/640?wx_fmt=other&amp;from=appmsg&amp;wxfrom=10005&amp;wx_lazy=1&amp;wx_co=1&amp;tp=webp\" style=\"outline: 0px;visibility: visible !important;width: 677px !important;\"/>\n</section>\n<section powered-by=\"werss\" style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;line-height: 1.75em;letter-spacing: 0.034em;font-style: normal;font-weight: normal;margin-top: 0px;margin-bottom: 0px;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7SkB6M2kMYzk2Ea1BO4eOlajZ0qxia4sy1AmyTOCTwWo9icdSZb4AR6NO727rjxvdCVMQicHCBKdOONg/640?wx_fmt=other&amp;from=appmsg&amp;wxfrom=10005&amp;wx_lazy=1&amp;wx_co=1&amp;tp=webp\" style=\"outline: 0px;visibility: visible !important;width: 677px !important;\"/>\n</section>\n<p style=\"margin: 0px;line-height: 1.75em;\">\n<strong>\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;font-weight: bold;\">\n            关于\n           </span>\n</span>\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;font-weight: bold;\">\n            梅里迪亚诺\n           </span>\n</span>\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;font-weight: bold;\">\n            农场\n           </span>\n</span>\n</strong>\n</p>\n<p>\n<span>\n<span style=\"font-size: 14px;\">\n           Finca Meridiano 坐落于厄瓜多尔皮钦查省（Pichincha）西北部壮丽的安第斯山脉地区，海拔 1,400 米（约 4,300 英尺），庄园于 2011 年 7 月正式开始咖啡种植生产。\n          </span>\n</span>\n</p>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/ruUhEq093b5PiaUyibrJ6eyrONHvy6MFsRxbTIUtSrgHiaKo2Pbb9vK5nZPlYBzz1B5F4hgpNorQCXP1wrnr6ozXyBDnMX3ic5Cu6pR2MnGtMo4/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/mmecoa_jpg/ruUhEq093b7hdRP7qD9pZ2tlp1eL3qHhZyyckEOtgbdU3nqzibzF4zQcmPx8cj7pjZ4zlpbAPBrkruSWtPRYxo7jXbQLGI9zmRbz2GHsBHw4/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<p style=\"margin: 0px;line-height: 1.75em;\">\n<span>\n<span style=\"font-size: 14px;\">\n           庄园主 Mario Hervas Chauvin 拥有农学学位，\n          </span>\n</span>\n<strong>\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n            从事农艺师17年，\n           </span>\n</span>\n</strong>\n<span>\n<span style=\"font-size: 14px;\">\n           对自然保护与生态议题充满热情。作为一名咖啡爱好者，他以极其严谨的标准审视自己的产品品质。所有用于生产的咖啡植株，均在其亲自监督下完成育苗、种植与全程管理。\n          </span>\n</span>\n</p>\n<p style=\"margin: 0px;line-height: 1.75em;\">\n<span>\n<br/>\n</span>\n</p>\n<p style=\"margin: 0px;line-height: 1.75em;\">\n<span>\n<span style=\"font-size: 14px;\">\n           获奖记录\n          </span>\n</span>\n</p>\n<p style=\"margin: 0px;line-height: 1.75em;\">\n<span>\n<span style=\"font-size: 14px;\">\n           2021 CoE#10\n          </span>\n</span>\n</p>\n<section powered-by=\"werss\" style=\"margin-top: 0px;margin-bottom: 0px;line-height: 1.75em;text-align: center;\">\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n           公众号的文章栏目有更多的咖啡信息\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"margin-top: 0px;margin-bottom: 0px;line-height: 1.75em;text-align: center;\">\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<span style=\"font-size: 14px;\">\n           客服微信：sabh_lt （售前/售后/加群）\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;line-height: 1.75em;letter-spacing: 0.034em;font-style: normal;font-weight: normal;margin-top: 0px;margin-bottom: 0px;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7RicESSboT2yAGicv25eicYwA9eYTVnj6tnDXYWHJ5amUjBqzNK6pdB5dhozgCKLqOuf9IgicGe5pVLibQ/640?wx_fmt=other&amp;wxfrom=10005&amp;wx_lazy=1&amp;wx_co=1&amp;tp=webp\" style=\"outline: 0px;caret-color: rgb(0, 0, 0);color: rgb(0, 0, 0);letter-spacing: normal;text-align: start;visibility: visible !important;width: 578px !important;\"/>\n</section>\n<section powered-by=\"werss\" style=\"margin-top: 0px;margin-bottom: 0px;line-height: 1.75em;\">\n<span style='color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;'>\n<br/>\n</span>\n</section>\n<p style=\"display: none;\">\n<mp-style-type data-value=\"3\">\n</mp-style-type>\n</p>\n</div>",
