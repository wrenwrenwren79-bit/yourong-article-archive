ans-serif;line-height: 1.75em;'>\n<br/>\n</section>\n<p style=\"letter-spacing: 0.578px;white-space: normal;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7QLIPGSSQh4nI0FCAicmOMOsk7LzC6x6rJHIwib3X2vm9TynezYliaYorfbicaias0OvbC10xEQXicU3Zyw/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</p>\n<p style=\"letter-spacing: 0.578px;white-space: normal;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7QLIPGSSQh4nI0FCAicmOMOsqibSn6gSselHSs3cl8ibHHsQJ88Kxyk0ziaYdKTMxq0bNyVc9Jc3dw2ow/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</p>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;outline: 0px;color: rgb(34, 34, 34);letter-spacing: 0.544px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);visibility: visible;line-height: 1.75em;'>\n<span style=\"outline: 0px;visibility: visible;font-size: 14px;\">\n<strong style=\"outline: 0px;visibility: visible;\">\n<span style=\"outline: 0px;color: rgb(0, 0, 0);font-family: Calibri, sans-serif;visibility: visible;\">\n            关于Elto\n           </span>\n</strong>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;outline: 0px;color: rgb(34, 34, 34);letter-spacing: 0.544px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);visibility: visible;line-height: 1.75em;text-align: left;'>\n<span style=\"font-size: 14px;letter-spacing: 0.544px;text-align: center;\">\n          Elto Coffee是一家专注于高品质埃塞的精品生豆出口商，由埃利亚斯·杜卡莫（Eliyas Dukamo）和阿提克利特·德杰内（Atiklit Dejene）于2022年创立致力于传递西达玛产区的卓越风味。\n         </span>\n</section>\n<p style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7SKz0BYc1L7Rc6Fanic5ZPRGicLxW3rGIcuGRniaFPAeac6Zt1Lq4C8iboTelFWia2RUzZAfxezh2VzONA/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</p>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;outline: 0px;color: rgb(34, 34, 34);letter-spacing: 0.544px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);visibility: visible;line-height: 1.75em;text-align: left;'>\n<span style=\"font-size: 14px;letter-spacing: 0.544px;text-align: center;\">\n</span>\n</section>\n<p style='margin-bottom: 0px;white-space: normal;outline: 0px;color: rgb(34, 34, 34);letter-spacing: 0.544px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: left;line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n          “埃尔托”（Elto）一词在西达玛语中意为“超越热爱”或“丰饶”，象征着Eliyas和Atiklit对咖啡品质的极致追求。\n         </span>\n</p>\n<section powered-by=\"werss\" style=\"margin-bottom: 0px;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7SKz0BYc1L7Rc6Fanic5ZPRGPtzaoo9RVicLxibHq6UOKtLWqZknaWOwLm8hfoDIrhUVr2kjBSpMX3yw/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style=\"margin-bottom: 0px;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7SKz0BYc1L7Rc6Fanic5ZPRG52N4J8LicX46uGVia808AlotwY4HmEv4WaQVBJKic3QkJnuWKLv5utOWg/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style='white-space: normal;outline: 0px;color: rgb(34, 34, 34);letter-spacing: 0.544px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;margin-bottom: 0px;'>\n<span style=\"font-size: 14px;letter-spacing: 0.544px;\">\n          Elora处理站～Elora是Eliyas的大女儿的名字；\n         </span>\n<br/>\n</section>\n<section powered-by=\"werss\" style='white-space: normal;outline: 0px;color: rgb(34, 34, 34);letter-spacing: 0.544px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;margin-bottom: 0px;'>\n<span style=\"font-size: 14px;letter-spacing: 0.544px;\">\n<br/>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"letter-spacing: 0.578px;white-space: normal;margin-bottom: 0px;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7SIDRj7OdMiaO0ZWljx1IGj5D06jkE46BjicEKicQvOcAWxGarVKtL2eoZqu8YlsgsKKd45juzn3dAvQ/640?wx_fmt=png\"/>\n</section>\n<p style=\"letter-spacing: 0.578px;white-space: normal;\">\n<br/>\n</p>\n<section powered-by=\"werss\" style=\"margin-bottom: 0px;\">\n<strong>\n<span style=\"font-size: 14px;letter-spacing: 0.034em;\">\n           关于这两个批次的处理\n          </span>\n</strong>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;margin-bottom: 0px;\">\n<span style=\"font-size: 14px;\">\n          厌氧日晒：将鲜果厌氧发酵72h后放置在室内120cm高的非洲晒床上进行干燥，果子铺厚度3-5cm左右保证通风顺畅，\n         </span>\n<span style=\"font-size: 14px;letter-spacing: 0.034em;\">\n          咖农们每20-30分钟搅拌一次保证均匀干燥，在\n         </span>\n<span style=\"font-size: 14px;letter-spacing: 0.034em;\">\n          10-14天后开始检查含水率；\n          <span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n</span>\n</section>\n<p style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7SKz0BYc1L7Rc6Fanic5ZPRG6zIhgkTf08Z4vfTf92sYx9NQ5Z62SOuIZoic0FtDAMGeLJISl1dYLGA/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</p>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;margin-bottom: 0px;\">\n<span style=\"font-size: 14px;letter-spacing: 0.034em;\">\n</span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;margin-bottom: 0px;\">\n<span style=\"font-size: 14px;letter-spacing: 0.476px;\">\n          厌氧蜜处理：\n         </span>\n<span style=\"font-size: 14px;letter-spacing: 0.034em;\">\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n          将鲜果去皮后放置在非洲晒床上进行干燥，平均每30分钟翻动一次，保证\n         </span>\n<span style=\"font-size: 14px;letter-spacing: 0.034em;\">\n          干燥均匀，干燥过程持续15-18天，具体取决于天气条件。\n         </span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;margin-bottom: 0px;\">\n<span style=\"font-size: 14px;letter-spacing: 0.034em;\">\n<br/>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;margin-bottom: 0px;\">\n<span style=\"font-size: 14px;letter-spacing: 0.476px;\">\n          两个视频资料，来自Elto Ins：\n          <span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\">\n<iframe allowfullscreen=\"\" class=\"video_iframe rich_pages\" data-cover=\"http%3A%2F%2Fmmecoa.qpic.cn%2Fsz_mmecoa_jpg%2FGr457cyFia7SKz0BYc1L7Rc6Fanic5ZPRGXiaDgDoyyzMcnfa7SE8Ec3icAYlYarR6aMA5tnicete01UMCNlkXVboFA%2F0%3Fwx_fmt%3Djpeg\" data-mpvid=\"wxv_3934032366783348752\" data-ratio=\"1.775\" data-src=\"https://mp.weixin.qq.com/mp/readtemplate?t=pages/video_player_tmpl&amp;action=mpvideo&amp;auto=0&amp;vid=wxv_3934032366783348752\" data-vidtype=\"2\" data-w=\"1278\" frameborder=\"0\" style=\"border-radius: 4px;\">\n</iframe>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;margin-bottom: 0px;\">\n<span style=\"font-size: 14px;letter-spacing: 0.476px;\">\n</span>\n</section>\n<section powered-by=\"werss\">\n<iframe allowfullscreen=\"\" class=\"video_iframe rich_pages\" data-cover=\"http%3A%2F%2Fmmecoa.qpic.cn%2Fsz_mmecoa_jpg%2FGr457cyFia7SKz0BYc1L7Rc6Fanic5ZPRGrfsxjYiaIJEiaf2ib9WgMicbkwStMlKP2Ob8WOBwqAtQjn9KzeLNvgWmYg%2F0%3Fwx_fmt%3Djpeg\" data-mpvid=\"wxv_3934040158542036994\" data-ratio=\"1.7722222222222221\" data-src=\"https://mp.weixin.qq.com/mp/readtemplate?t=pages/video_player_tmpl&amp;action=mpvideo&amp;auto=0&amp;vid=wxv_3934040158542036994\" data-vidtype=\"2\" data-w=\"1276\" frameborder=\"0\" style=\"border-radius: 4px;\">\n</iframe>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0em;white-space: normal;outline: 0px;color: rgb(34, 34, 34);font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;visibility: visible;'>\n<span style='font-size: 14px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;'>\n          更多咖啡豆选购，请关注淘宝店铺哦～\n         </span>\n<br/>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;outline: 0px;color: rgb(34, 34, 34);letter-spacing: 0.544px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n          公众号的文章栏目有更多的咖啡信息\n         </span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;outline: 0px;color: rgb(34, 34, 34);letter-spacing: 0.544px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;'>\n<span style='outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;'>\n          客服微信：sabh_lt （售前/售后/加群）\n         </span>\n</section>\n<p>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7RicESSboT2yAGicv25eicYwA9eYTVnj6tnDXYWHJ5amUjBqzNK6pdB5dhozgCKLqOuf9IgicGe5pVLibQ/640?wx_fmt=other&amp;wxfrom=10005&amp;wx_lazy=1&amp;wx_co=1&amp;tp=webp\" style=\"letter-spacing: normal;text-align: start;white-space: normal;outline: 0px;font-size: var(--articleFontsize);caret-color: rgb(0, 0, 0);color: rgb(0, 0, 0);visibility: visible !important;width: 578px !important;\"/>\n</p>\n<p style=\"display: none;\">\n<mp-style-type data-value=\"3\">\n</mp-style-type>\n</p>\n</div>",
