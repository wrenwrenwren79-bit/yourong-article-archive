n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n</span>\n</section>\n<p style=\"line-height: 1.75em;white-space: normal;\">\n<span style=\"color: black;font-family: Calibri, sans-serif;font-size: 14px;\">\n</span>\n</p>\n<p>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7SkB6M2kMYzk2Ea1BO4eOlajZ0qxia4sy1AmyTOCTwWo9icdSZb4AR6NO727rjxvdCVMQicHCBKdOONg/640?wx_fmt=png&amp;from=appmsg\"/>\n</p>\n<p>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7SkB6M2kMYzk2Ea1BO4eOlaO8st3wWJAg8NrbKv0ymTtX1xo0yeJBml4nzPibBlPff0RqafqOu42FQ/640?wx_fmt=png&amp;from=appmsg\"/>\n</p>\n<p style=\"line-height: 1.75em;white-space: normal;\">\n<span style=\"color: black;font-family: Calibri, sans-serif;font-size: 14px;\">\n</span>\n</p>\n<p style=\"text-align: center;\">\n<img src=\"https://mmbiz.qpic.cn/mmbiz_png/Gr457cyFia7Tia6593icv0lvf4dHREGOfbmAfP622IA0ctib7XLruCiaic1fylcq16UlTRsAfTqJ7ic2yrts31yszWxsw/640?wx_fmt=png\"/>\n</p>\n<p style=\"text-align: center;\">\n<span style=\"color: rgb(178, 178, 178);font-size: 14px;\">\n          洛哈在厄瓜多尔的南部\n         </span>\n</p>\n<p style=\"text-align: center;\">\n<span style=\"color: rgb(178, 178, 178);font-size: 14px;\">\n          图片来源\n          <a data-linktype=\"2\" href=\"https://www.cafeimports.com/europe/ecuador\" target=\"_blank\">\n           CAFE IMPORT\n          </a>\n</span>\n</p>\n<p>\n<strong>\n<span style=\"font-size: 14px;\">\n<br/>\n</span>\n</strong>\n</p>\n<p>\n<strong>\n<span style=\"font-size: 14px;\">\n           关于Eliza\n           <span style=\"font-family: 微软雅黑;font-size: 13.3333px;\">\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n<span style=\"display: none;line-height: 0px;\">\n             ‍\n            </span>\n</span>\n</span>\n</strong>\n</p>\n<hr style=\"border-width: 1px 0px 0px;border-style: solid;border-color: rgba(0, 0, 0, 0.1);transform-origin: 0% 0%;transform: scale(1, 0.5);-webkit-transform: scale(1, 0.5);-webkit-transform-origin: 0 0;\"/>\n<p>\n<span style=\"font-size: 14px;\">\n</span>\n</p>\n<p>\n<span>\n</span>\n<span style=\"text-align: justify;font-size: 14px;color: rgb(34, 34, 34);font-family: PingFangSC-light;letter-spacing: 1px;background-color: rgb(255, 255, 255);\">\n          伊丽莎庄园坐落于厄瓜多尔的洛哈省，于2016年被马丁·库奇（Martin\n         </span>\n<span style=\"color: rgb(34, 34, 34);font-family: PingFangSC-light;font-size: 14px;letter-spacing: 1px;background-color: rgb(255, 255, 255);\">\n          Kutsch）和他的女儿们买下。马丁是一个咖啡爱好者，在多次访问巴拿马波魁特\n         </span>\n<span style=\"color: rgb(34, 34, 34);font-family: PingFangSC-light;font-size: 14px;letter-spacing: 1px;background-color: rgb(255, 255, 255);\">\n          后，成为一个专业的咖农。马丁和他的朋友伯纳德Bernard Uhe一起到巴拿马波魁特度过了\n         </span>\n<span style=\"color: rgb(34, 34, 34);font-family: PingFangSC-light;font-size: 14px;letter-spacing: 1px;background-color: rgb(255, 255, 255);\">\n          一段咖啡之旅。在了解了精品咖啡后，马丁和伯纳德开始寻找并找到了优质的精\n         </span>\n<span style=\"color: rgb(34, 34, 34);font-family: PingFangSC-light;font-size: 14px;letter-spacing: 1px;background-color: rgb(255, 255, 255);\">\n          品咖啡品种，并在伊丽莎庄园里种植了这些咖啡。\n         </span>\n</p>\n<p style=\"text-align: left;\">\n<span style=\"text-align: justify;font-size: 14px;color: rgb(34, 34, 34);font-family: PingFangSC-light;letter-spacing: 1px;background-color: rgb(255, 255, 255);\">\n          伊丽莎庄园由CVM（伯纳德家族的农业公司）管理，庄园的咖农是来自哥伦比亚伊巴格省的几代咖啡种植者。他们与当地的厄瓜多尔咖农一起，在厄瓜多尔安第斯山脉高海拔地区种植阿拉比卡咖啡。是什么让他们的咖啡如此出色，是高海拔、肥沃的土壤、富含矿物质的山泉水、茂密的树荫、全年12小时的阳光以及咖啡是用楝树和虫茶熏蒸的，庄园不使用化学熏蒸。\n         </span>\n</p>\n<p>\n<span style=\"font-size: 10pt;font-family: 微软雅黑;\">\n<br/>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n</span>\n</p>\n<p style=\"text-align: left;\">\n<span style=\"text-align: justify;font-size: 14px;color: rgb(34, 34, 34);font-family: PingFangSC-light;letter-spacing: 1px;background-color: rgb(255, 255, 255);\">\n          伊丽莎庄园目前主要种植3个品种的精品咖啡：绿顶瑰夏、波旁希爪和改良铁皮卡。根据种植咖啡品种的不同庄园划分成三个地块，分别是：\n         </span>\n</p>\n<p style=\"text-align: left;\">\n<span style=\"text-align: justify;font-size: 14px;color: rgb(34, 34, 34);font-family: PingFangSC-light;letter-spacing: 1px;background-color: rgb(255, 255, 255);\">\n          1）绿顶瑰夏地块海拔高度为1740米。\n         </span>\n</p>\n<p style=\"text-align: left;\">\n<span style=\"text-align: justify;font-size: 14px;color: rgb(34, 34, 34);font-family: PingFangSC-light;letter-spacing: 1px;background-color: rgb(255, 255, 255);\">\n          2）波旁希爪地块海拔高度为1710米\n         </span>\n</p>\n<p style=\"text-align: left;\">\n<span style=\"text-align: justify;font-size: 14px;color: rgb(34, 34, 34);font-family: PingFangSC-light;letter-spacing: 1px;background-color: rgb(255, 255, 255);\">\n          3）改良铁皮卡海拔高度为1740米。\n         </span>\n</p>\n<p style=\"text-align: left;\">\n<span style=\"text-align: justify;font-size: 14px;color: rgb(34, 34, 34);font-family: PingFangSC-light;letter-spacing: 1px;background-color: rgb(255, 255, 255);\">\n          处理方式：\n         </span>\n</p>\n<p style=\"text-align: left;\">\n<span style=\"text-align: justify;font-size: 14px;color: rgb(34, 34, 34);font-family: PingFangSC-light;letter-spacing: 1px;background-color: rgb(255, 255, 255);\">\n          采摘成熟鲜红的咖啡鲜果，将咖啡鲜果倒入水槽中清洗，去除浮果。接着将咖啡鲜果放入发酵袋中发酵48小时，每12小时翻转一次袋子。然后将鲜果去除果皮果肉，再次放入发酵袋中发酵48小时，每12小时翻转一次袋子。最后倒入水槽中彻底洗净咖啡豆表面。将洗净的咖啡豆放在凸起的晒床上，每8小时翻动一次，至少干燥10天，直到咖啡豆含水率降到9.5%到11%之间。将保留羊皮纸的咖啡豆以45公斤/谷物袋进行储存，储存区需要气候适宜，保持16℃~18℃的温度和48%~52%的湿度。\n         </span>\n</p>\n<section powered-by=\"werss\" style=\"line-height: 1.6em;text-align: justify;margin: 0px;text-indent: 0em;\">\n<br/>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.6em;text-align: justify;margin: 0px;text-indent: 0em;\">\n<span style=\"text-align: justify;font-size: 14px;color: rgb(34, 34, 34);font-family: PingFangSC-light;letter-spacing: 1px;background-color: rgb(255, 255, 255);\">\n          巧合中的必然，我们买过的Noria, Dorado都是CVM公司管理的农场，可能厄瓜多尔现在比较有名的几个农场都跟CVM有关联～\n         </span>\n<span style=\"display: none;line-height: 0px;\">\n          ‍\n         </span>\n<span style=\"display: none;line-height: 0px;\">\n          ‍\n         </span>\n<span style=\"display: none;line-height: 0px;\">\n          ‍\n         </span>\n<span style=\"display: none;line-height: 0px;\">\n          ‍\n         </span>\n<span style=\"display: none;line-height: 0px;\">\n          ‍\n         </span>\n<span style=\"display: none;line-height: 0px;\">\n          ‍\n         </span>\n<span style=\"display: none;line-height: 0px;\">\n          ‍\n         </span>\n<span style=\"display: none;line-height: 0px;\">\n          ‍\n         </span>\n<span style=\"display: none;line-height: 0px;\">\n          ‍\n         </span>\n<span style=\"display: none;line-height: 0px;\">\n          ‍\n         </span>\n<span style=\"display: none;line-height: 0px;\">\n          ‍\n         </span>\n<span style=\"display: none;line-height: 0px;\">\n          ‍\n         </span>\n<span style=\"display: none;line-height: 0px;\">\n          ‍\n         </span>\n<span style=\"display: none;line-height: 0px;\">\n          ‍\n         </span>\n<span style=\"display: none;line-height: 0px;\">\n          ‍\n         </span>\n<span style=\"display: none;line-height: 0px;\">\n          ‍\n         </span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.6em;text-align: justify;margin: 0px;text-indent: 0em;\">\n<br/>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.6em;text-align: justify;margin: 0px;text-indent: 0em;\">\n<strong>\n<span style=\"color: rgb(34, 34, 34);background-color: rgb(255, 255, 255);font-size: 14px;letter-spacing: 1px;text-decoration: none solid rgb(34, 34, 34);\">\n           Bourbon Sidra 波旁希爪\n          </span>\n</strong>\n</section>\n<p style=\"text-align: justify;margin: 0px;text-indent: 0em;line-height: 1.75em;\">\n<span style=\"color: rgb(34, 34, 34);background-color: rgb(255, 255, 255);font-size: 14px;letter-spacing: 1px;text-decoration: none solid rgb(34, 34, 34);\">\n          它是基于红波旁和铁皮卡（或者是铁皮卡基因谱系的埃塞品种）的杂交而得的品种，也被称作Sidra/Sydra, 发源于雀巢在厄瓜多尔资助的一个咖啡研究农场，它的研发动机就是为了找寻一个风味更佳的品种，可以兼具波旁饱满的甜感和铁皮卡的细腻优雅的花香，现在在哥伦比亚也有种植。（有说法说Sidra其实就是某种埃塞原生种，并非什么所谓的波旁和铁皮卡谱系杂交）。\n         </span>\n<strong>\n<span style=\"color: rgb(34, 34, 34);background-color: rgb(255, 255, 255);font-size: 14px;letter-spacing: 1px;text-decoration: none solid rgb(34, 34, 34);\">\n</span>\n</strong>\n</p>\n<p style=\"text-align: justify;margin: 0px;text-indent: 0em;line-height: 1.75em;\">\n<span style=\"color: rgb(34, 34, 34);background-color: rgb(255, 255, 255);font-size: 14px;letter-spacing: 1px;text-decoration: none solid rgb(34, 34, 34);\">\n<br/>\n</span>\n</p>\n<section powered-by=\"werss\" style=\"line-height: 1.6em;text-align: justify;margin: 0px;text-indent: 0em;\">\n<strong>\n<span style=\"color: rgb(34, 34, 34);background-color: rgb(255, 255, 255);font-size: 14px;letter-spacing: 1px;text-decoration: none solid rgb(34, 34, 34);\">\n           Typica Mejorada 增强铁皮卡\n          </span>\n</strong>\n</section>\n<section powered-by=\"werss\" style=\"text-align: justify;margin: 0px;text-indent: 0em;line-height: 1.75em;\">\n<span style=\"color: rgb(34, 34, 34);background-color: rgb(255, 255, 255);font-size: 14px;letter-spacing: 1px;text-decoration: none solid rgb(34, 34, 34);\">\n          这个是厄瓜多尔近几年很火热的一个品种，与Sidra并驾齐驱横扫厄瓜多尔的咖啡生豆赛事，但据世界咖啡研究中心WCR的基因检测结果，它应该是一个波旁品种与埃塞的某原生品种杂交而得，目前在厄瓜多尔和哥斯达黎加都有种植。\n         </span>\n</section>\n<p style=\"text-align: justify;margin: 0px;text-indent: 0em;line-height: 1.75em;\">\n<span style=\"color: rgb(34, 34, 34);background-color: rgb(255, 255, 255);font-size: 14px;letter-spacing: 1px;text-decoration: none solid rgb(34, 34, 34);\">\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n           ‍\n          </span>\n</span>\n</p>\n<p style=\"text-align: center;\">\n<br/>\n</p>\n<section powered-by=\"werss\" style='margin-bottom: 0em;outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;color: rgb(34, 34, 34);background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;visibility: visible;'>\n<span style='outline: 0px;font-size: 14px;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;'>\n          公众号的文章栏目有更多的咖啡信息\n         </span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;'>\n<span style='outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;'>\n          客服微信：sabh_lt （售前/售后/加群）\n         </span>\n</section>\n<p style='margin-bottom: 0px;outline: 0px;font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;white-space: normal;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7RicESSboT2yAGicv25eicYwA9eYTVnj6tnDXYWHJ5amUjBqzNK6pdB5dhozgCKLqOuf9IgicGe5pVLibQ/640?wx_fmt=other&amp;wxfrom=5&amp;wx_lazy=1&amp;wx_co=1&amp;tp=webp\" style=\"outline: 0px;caret-color: rgb(0, 0, 0);color: rgb(0, 0, 0);letter-spacing: normal;text-align: start;visibility: visible !important;width: 578px !important;\"/>\n</p>\n<hr style=\"border-width: 1px 0px 0px;border-style: solid;border-color: rgba(0, 0, 0, 0.098);transform: scale(1, 0.5);transform-origin: 0px 0px;\"/>\n<p style=\"display: none;\">\n<mp-style-type data-value=\"10000\">\n</mp-style-type>\n</p>\n</div>",
