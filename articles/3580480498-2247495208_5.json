i UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: auto;text-indent: 0px;text-transform: none;white-space: normal;widows: auto;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration: none;text-align: center;visibility: visible;'>\n<img src=\"https://mmbiz.qpic.cn/mmbiz_png/Gr457cyFia7QKiaZgPyfAHCibb4mlcMPJic6QwAWcSHMrgnsornPaWh0k47SBg1fLwWS0viae9l8Xk9kWJoWgnFUdUQ/640?wx_fmt=png&amp;tp=webp&amp;wxfrom=10005&amp;wx_lazy=1#imgIndex=0\" style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;vertical-align: bottom;height: auto !important;visibility: visible !important;width: 677px !important;\"/>\n</section>\n<section powered-by=\"werss\" style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;caret-color: rgba(0, 0, 0, 0.9);color: rgba(0, 0, 0, 0.9);font-family: \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: auto;text-indent: 0px;text-transform: none;white-space: normal;widows: auto;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration: none;line-height: 1.75em;text-align: center;'>\n<span style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;font-size: 12px;\">\n<span>\n           La Paz 位于地图中下部\n          </span>\n</span>\n<span>\n<br/>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;clear: both;min-height: 1em;caret-color: rgba(0, 0, 0, 0.9);color: rgba(0, 0, 0, 0.9);font-family: \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: auto;text-align: justify;text-indent: 0px;text-transform: none;white-space: normal;widows: auto;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration: none;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7SkB6M2kMYzk2Ea1BO4eOlajZ0qxia4sy1AmyTOCTwWo9icdSZb4AR6NO727rjxvdCVMQicHCBKdOONg/640?wx_fmt=png&amp;from=appmsg&amp;tp=webp&amp;wxfrom=10005&amp;wx_lazy=1#imgIndex=1\" style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;vertical-align: bottom;height: auto !important;visibility: visible !important;width: 677px !important;\"/>\n</section>\n<section powered-by=\"werss\" style='margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;clear: both;min-height: 1em;caret-color: rgba(0, 0, 0, 0.9);color: rgba(0, 0, 0, 0.9);font-family: \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: auto;text-align: justify;text-indent: 0px;text-transform: none;white-space: normal;widows: auto;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration: none;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7SkB6M2kMYzk2Ea1BO4eOlaO8st3wWJAg8NrbKv0ymTtX1xo0yeJBml4nzPibBlPff0RqafqOu42FQ/640?wx_fmt=png&amp;from=appmsg&amp;tp=webp&amp;wxfrom=10005&amp;wx_lazy=1#imgIndex=2\" style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;vertical-align: bottom;height: auto !important;visibility: visible !important;width: 677px !important;\"/>\n</section>\n<p style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;clear: both;min-height: 1em;caret-color: rgba(0, 0, 0, 0.9);color: rgba(0, 0, 0, 0.9);font-family: \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: auto;text-align: justify;text-indent: 0px;text-transform: none;white-space: normal;widows: auto;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration: none;line-height: 1.75em;'>\n<strong style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n<span style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;font-size: 14px;\">\n<span>\n            关于浴场庄园\n           </span>\n</span>\n</strong>\n</p>\n<section powered-by=\"werss\">\n<span>\n<span style=\"font-size: 14px;\">\n           浴场庄园位于海拔1750米的高地。庄园主Hotilio每天需要驾车30分钟，再步行一小时才能抵达咖啡种植园。他对咖啡的热情源自童年，他的父亲（拥有该地区四个庄园）不仅传授给他关于咖啡的知识，还教他种植、修剪、施肥、采摘和处理咖啡的技巧。2009年，他协助父亲准备了一批参加卓越杯（COE）的咖啡，并获得了第11名的好成绩。这一成就成为了他创办自己独立庄园的契机。在IHCAFE的支持下，他在继承自父亲最高海拔庄园的土地上种植了IH90和卡杜艾，并制定了一整套完善的管理方案，保障正确施肥、修剪和控制病虫害。\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7TWGleVFGmIbxbBxZdc41EcJj1miaXkr2gMr1X4d33NVdDFiam5qICvHMricCSWEIZssIHwkok8BiadgA/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\">\n<span>\n<span style=\"font-size: 14px;\">\n           在收获第一批咖啡豆时，尽管对自己的庄园能否获胜还并不自信，他依旧决定参加COE竞赛。2012年，庄园的卡杜艾出乎意料地获得了第三名的成绩。之后也多次参加并取得成绩，这也鼓励了他不断进步且更加自信，他以生产水洗咖啡为荣，庄园使用干净的山泉水，缓慢干燥，确保咖啡的最佳表现。\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\">\n<span>\n<span style=\"font-size: 14px;\">\n           几年前，为了丰富庄园的品种并获取更高收益，Hotilio拿到了瑰夏种子，并将其种植在庄园海拔最高的1公顷土地上。\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7TWGleVFGmIbxbBxZdc41EcHaKXRexJEeGHSmPsJFM04lxgVzw65YlXJE7z0wdJzTxNawN24xnWPw/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<p style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;clear: both;min-height: 1em;caret-color: rgba(0, 0, 0, 0.9);color: rgba(0, 0, 0, 0.9);font-family: \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: auto;text-align: justify;text-indent: 0px;text-transform: none;white-space: normal;widows: auto;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration: none;line-height: 1.75em;'>\n<strong style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n<span style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;font-size: 14px;\">\n<span>\n            处理细节\n           </span>\n</span>\n</strong>\n</p>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;\">\n<span>\n<span style=\"font-size: 14px;\">\n           采摘过程中，分阶段多次手选每次只采摘最成熟的樱桃。采摘后，使用干净的山泉水洗去果皮果肉，进行36小时的自然发酵。发酵完成后，再用干净的山泉水彻底清洗，转移至高架床上晾晒25天左右，期间不断翻动确保干燥均匀，直至达到理想含水率收起储藏静置。\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7TWGleVFGmIbxbBxZdc41Ec9W5Gq3llsG87apFUEDpbzgIXZnuES0zNMlRyp8RIib0XpPVPP2ia7dpw/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style='margin: 0px 0px 0em;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;font-family: \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: auto;text-indent: 0px;text-transform: none;white-space: normal;widows: auto;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration: none;color: rgb(34, 34, 34);background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;visibility: visible;'>\n<span style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;font-size: 14px;font-family: \"PingFang SC\", -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;'>\n<span>\n           公众号的文章栏目有更多的咖啡信息\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;font-size: 17px;font-style: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: auto;text-indent: 0px;text-transform: none;white-space: normal;widows: auto;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration: none;color: rgb(34, 34, 34);font-family: \"PingFang SC\", -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;'>\n<span style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;font-family: \"PingFang SC\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;'>\n<span>\n           客服微信：sabh_lt （售前/售后/加群）\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\">\n<span>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7RicESSboT2yAGicv25eicYwA9eYTVnj6tnDXYWHJ5amUjBqzNK6pdB5dhozgCKLqOuf9IgicGe5pVLibQ/640?wx_fmt=other&amp;wxfrom=10005&amp;wx_lazy=1&amp;wx_co=1&amp;tp=webp#imgIndex=6\" style=\"font-style: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: normal;orphans: auto;text-align: start;text-indent: 0px;text-transform: none;white-space: normal;widows: auto;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration: none;outline: 0px;caret-color: rgb(0, 0, 0);color: rgb(0, 0, 0);visibility: visible !important;width: 578px !important;height: auto !important;\"/>\n</span>\n</section>\n<p style=\"display: none;\">\n<mp-style-type data-value=\"3\">\n</mp-style-type>\n</p>\n</div>",
