;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;line-height: 1.75em;'>\n<span style=\"font-size: 14px;\">\n<span>\n           去年我们首次买到Tamru的日晒批次，当时印象很深它与特别像Buku和Yaye日晒的综合，入口很集中的成熟芒果香气，然后转类似杏桃，蓝莓的果肉感；今年我们有日晒和厌氧日晒两个批次，测了几轮感受厌氧日晒与日晒批次差异不是很大，厌氧日晒批次的发酵感更多体现在会带一些菠萝特征，整体会往热带水果偏一些，而日晒更多杏桃和蓝莓的那种成熟酸甜，于是我们尝试将他们合并一起测试发现，嗯，想要的都有了～喜欢！\n          </span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n</span>\n</section>\n<p style=\"text-align: center;\">\n<span>\n<br/>\n</span>\n</p>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;line-height: 1.75em;'>\n<span style=\"font-size: 14px;\">\n</span>\n</section>\n<section powered-by=\"werss\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7SkB6M2kMYzk2Ea1BO4eOlajZ0qxia4sy1AmyTOCTwWo9icdSZb4AR6NO727rjxvdCVMQicHCBKdOONg/640?wx_fmt=png&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7SkB6M2kMYzk2Ea1BO4eOlaO8st3wWJAg8NrbKv0ymTtX1xo0yeJBml4nzPibBlPff0RqafqOu42FQ/640?wx_fmt=png&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;line-height: 1.75em;'>\n<span style=\"font-size: 14px;\">\n<span>\n<br/>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;line-height: 1.75em;'>\n<span style=\"font-size: 14px;\">\n<span>\n<br/>\n</span>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;line-height: 1.75em;'>\n<strong>\n<span style=\"font-size: 14px;\">\n<span>\n            关于 Gonjobe 与 咖农 Tamru Godana Doba\n           </span>\n</span>\n</strong>\n<span style=\"font-size: 14px;\">\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;line-height: 1.75em;'>\n<span style=\"font-size: 14px;\">\n<span style=\"font-size: 14px;letter-spacing: 0.544px;text-decoration: none;\">\n<span style=\"font-size: 14px;letter-spacing: 0.544px;text-decoration: none;\">\n<span style='font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;'>\n<span style='font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;'>\n<span>\n               //图片和文字来源 ： 印格咖啡\n              </span>\n</span>\n</span>\n</span>\n</span>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;line-height: 1.75em;'>\n<span style=\"font-size: 14px;\">\n<span style=\"font-size: 14px;letter-spacing: 0.544px;text-decoration: none;\">\n<span style=\"font-size: 14px;letter-spacing: 0.544px;text-decoration: none;\">\n<span style='font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;'>\n<span>\n              Gonjobe村坐落于西达摩省的班莎区，村名源自流经此地的一条河流，Gonjobe在当地语言里是“朋友”“伙伴”的意思；\n             </span>\n</span>\n<span>\n             Gonjobe村是一片风景优美，却也是非常陡峭的山谷向阳面，海拔2300米以上，每爬一段都需要耗费大量的体力。而Gonjobe村的村民，正是在这里，年复一年地用心培育咖啡鲜果，小心翼翼地进行采摘。每次咖啡果采收完毕，咖啡农都要将果实从陡峭的山坡上运往遥远的山脚的Gonjobe处理站进行加工处理；\n            </span>\n</span>\n</span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7RnibsY53huYyxib7R844jbh2a5noicOSkt2uCVicLrRr8dajOCUmy3WquWAWLYzPs9tGmsrk675QDN9A/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7RnibsY53huYyxib7R844jbh2MRyic2OhEccR9sxa7z2vVVyofRL2miay1n8Ruft4HEa7U7s2NKWpkKUw/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;line-height: 1.75em;'>\n<span style=\"font-size: 14px;\">\n<span style=\"font-size: 14px;letter-spacing: 0.544px;text-decoration: none;\">\n<span style=\"font-size: 14px;letter-spacing: 0.544px;text-decoration: none;\">\n<span>\n             这支咖啡是由56岁的Tamru Godana Doba种植，他是一个很普通的咖农，有12个子女，田里除了种植咖啡外，也种植假香蕉（False Banana，长得像香蕉树，但果实不可食用，主要是吃它的根茎，可以给咖啡遮荫）和小麦；去年我们曾买到少量的一批空运批次，今年我们很开心再次买到同一生产者的日晒和厌氧日晒两种处理方式，他们有非常相似的热带水果像芒果/菠萝和杏桃类的果肉果汁感，我们又做了一个比较符合我们自己但是不大常理出牌的方式，将它两拼配起来，这样就有一杯热带水果/核果/莓果柑橘都有酸甜可口的美味果汁啦～充满了阳光的味道！\n            </span>\n<section powered-by=\"werss\">\n<span>\n<br/>\n</span>\n</section>\n</span>\n</span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7TgaZxq21LYakiawP0AJaFkLXicGwqV8ox9sEJFzYmTSZnJib0xibfF3kkicm7HerPzCknPpibybc64wQWQ/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;line-height: 1.75em;'>\n<span style=\"font-size: 14px;\">\n<span style=\"font-size: 14px;letter-spacing: 0.544px;text-decoration: none;\">\n<span style=\"font-size: 14px;letter-spacing: 0.544px;text-decoration: none;\">\n</span>\n</span>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;line-height: 1.75em;'>\n<strong>\n<span style=\"font-size: 14px;\">\n<span>\n            加工处理过程：\n           </span>\n</span>\n</strong>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;line-height: 1.75em;'>\n<strong>\n<span style=\"font-size: 14px;\">\n<span>\n            注意：厌氧日晒的处理过程大部分与日晒相同，区别是咖啡鲜果筛选后放入塑料桶中进行96小时的厌氧发酵，然后再晒床晾晒；\n           </span>\n</span>\n</strong>\n</section>\n<ul class=\"list-paddingleft-1\" style=\"list-style-type: circle;\">\n<li>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;line-height: 1.75em;'>\n<span style=\"font-size: 14px;\">\n<span>\n             鲜果采摘，类似Tamru的小农家庭，咖啡果的采摘都是家庭成员一起协助完成；在前些时间去秘鲁的一些农场也是这样子，能自己家里人一起搞定的就不用请工来帮忙了；\n            </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7TgaZxq21LYakiawP0AJaFkLpRkiaFUNagB0fUchCL3MVcfIbHdibickWbDNxrNBcnkgJoxicIB6s7BWBw/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n</li>\n<li>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;line-height: 1.75em;'>\n<span style=\"font-size: 14px;\">\n<span>\n             晾晒，因为是做日晒，所以鲜果采摘后不脱皮，直接拌匀到晒床；在晒床上，每天一遍翻动，帮助咖啡果的均匀晾晒，同时也有机会再筛除一些有问题的果子；\n            </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7RnibsY53huYyxib7R844jbh2TxPvb6n6ndtI3XluCeKNVibqM64YRMcnYwXvP4Mphe112GVr5EA28hw/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmecoa.qpic.cn/sz_mmecoa_jpg/Gr457cyFia7RnibsY53huYyxib7R844jbh2L6bF8YiaMKARkHGw0HKxq0MQR5IF0s4rcQjicibsG6OydfvA2jcXfdKAg/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n<section powered-by=\"werss\">\n<span>\n<br/>\n</span>\n</section>\n</li>\n<li>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;line-height: 1.75em;'>\n<span style=\"font-size: 14px;\">\n<span>\n             收储静置，晾晒到合适的含水率（通过仪器或者传统经验方式判断），干果就会收到仓库里集中存放，这一步非常的重要，它可以让豆子里的水份稳定均值下来，这样后期在烘焙端的存储和烘焙使用会更长久稳定；\n            </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"text-align: center;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7TgaZxq21LYakiawP0AJaFkL0NEVGRxy55OEUD6CvFcoEMiaibD5sib1ozsfibBJuhInOlpy98mekQCqqA/640?wx_fmt=jpeg&amp;from=appmsg\"/>\n</section>\n</li>\n<li>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;line-height: 1.75em;'>\n<span style=\"font-size: 14px;\">\n<span>\n             脱壳，装袋，出口，这就是豆子在源产地端的最后一个大环节了，接下来豆子就漂洋过海到了我们的消费端烘焙厂商的手里，经过烘焙包装作为咖啡熟豆进入千家万户。\n            </span>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;line-height: 1.75em;'>\n<span style=\"font-size: 14px;\">\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;white-space: normal;font-family: -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;letter-spacing: 0.544px;line-height: 1.75em;'>\n<span style=\"font-size: 14px;\">\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n              ‍\n             </span>\n</span>\n</span>\n</section>\n</li>\n</ul>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;text-align: center;margin: 0px;text-indent: 0em;\">\n<span style=\"font-size: 14px;letter-spacing: 0.544px;text-decoration: none;\">\n<span>\n<br/>\n</span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;text-align: center;margin: 0px;text-indent: 0em;\">\n<span style=\"font-size: 14px;letter-spacing: 0.544px;text-decoration: none;\">\n<span>\n           更多咖啡豆选购，请关注淘宝店铺哦～\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;text-align: center;margin: 0px;text-indent: 0em;\">\n<span style=\"font-size: 14px;letter-spacing: 0.544px;text-decoration: none;\">\n<span>\n           公众号的文章栏目有更多的咖啡信息\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;text-align: center;margin: 0px;text-indent: 0em;\">\n<span style=\"font-size: 14px;letter-spacing: 0.544px;text-decoration: none;\">\n<span>\n           客服微信：sabh_lt （售前/售后/加群）\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;text-align: justify;margin: 0px;text-indent: 0em;\">\n<span style=\"font-size: 14px;letter-spacing: 0.544px;text-decoration: none;\">\n<span>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7RicESSboT2yAGicv25eicYwA9eYTVnj6tnDXYWHJ5amUjBqzNK6pdB5dhozgCKLqOuf9IgicGe5pVLibQ/640?wx_fmt=other&amp;wxfrom=10005&amp;wx_lazy=1&amp;wx_co=1&amp;tp=webp\" style=\"letter-spacing: normal;text-align: start;white-space: normal;outline: 0px;font-size: var(--articleFontsize);caret-color: rgb(0, 0, 0);color: rgb(0, 0, 0);visibility: visible !important;width: 578px !important;\"/>\n</span>\n<span style=\"display: none;line-height: 0px;\">\n<span>\n            ‍\n           </span>\n</span>\n</span>\n</section>\n<p style=\"display: none;\">\n<mp-style-type data-value=\"3\">\n</mp-style-type>\n</p>\n</div>",
