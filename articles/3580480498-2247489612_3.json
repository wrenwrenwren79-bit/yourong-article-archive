px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;background-color: rgb(255, 255, 255);text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<br/>\n</p>\n<p style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;color: rgb(34, 34, 34);font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-indent: 0px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;background-color: rgb(255, 255, 255);text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;text-align: center;visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7TWPEXxn88NbEX8jW31ibicxlibHdoEULvMxNyHrPPR3dynYHVItkoXv4YBA1k9LvV46zSkEMiaMIAEFQ/640?wx_fmt=jpeg&amp;wxfrom=5&amp;wx_lazy=1&amp;wx_co=1\" style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;vertical-align: bottom;height: auto !important;visibility: visible !important;width: 578px !important;\"/>\n</p>\n<p style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;color: rgb(34, 34, 34);font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;background-color: rgb(255, 255, 255);text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;visibility: visible;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;visibility: visible;font-size: 14px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n<strong style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;\">\n           庄园介绍\n          </strong>\n</span>\n</p>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;margin-bottom: 0px;\">\n<span style=\"font-size: 14px;\">\n          狂风庄园位于安蒂奥基亚省圣芭芭拉山区，当地的海拔高度为1750米到2000米，狂风庄园海拔1820米。Trujillo家族种植咖啡的历史可以追溯到50年前。庄园名字 La Ventolera 在西班牙语中有狂风、突然袭来的灵感之意。老庄园主Alejandro先生不仅在种植咖啡方面颇有心得，同时也是一名专业的建筑师和画家，他把所做的一切当做艺术品来对待，对特殊处理法有着创新意识和热情。2021年，狂风庄园的咖啡生产由老庄主的儿子Felipe Trujillo接手，Felipe是当地非常有名的企业家，他把狂风庄园改造成咖啡生产教学基地，为当地咖农处理法的改善做出了很多努力。\n         </span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;margin-bottom: 0px;\">\n<span style=\"font-size: 14px;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7S70WrDy6NVbbVn7nzGLzvgicgZiacK3AVAwcwQqgCAr4blAOkdMouPibLSiahg8jSom8gt5ZSc0YNxpg/640?wx_fmt=jpeg\" style='margin: 0px;padding: 0px;max-width: 100%;height: auto !important;vertical-align: bottom;color: rgb(51, 51, 51);font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: normal;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;'/>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;margin-bottom: 0px;\">\n<span style=\"font-size: 14px;\">\n<br/>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"line-height: 1.75em;margin-bottom: 0px;\">\n<span style=\"font-size: 14px;\">\n          狂风庄园从鲜果采摘、处理加工到杯品把控方面都做了严格控制，全程记录处理过程，达到真正的100%可追溯。庄园的卫生条件也十分严格，对待咖啡的严谨态度给人留下深刻印象。\n         </span>\n</section>\n<section powered-by=\"werss\" style='margin: 0px 8px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgb(34, 34, 34);font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;visibility: visible;'>\n<br/>\n</section>\n<section powered-by=\"werss\" style=\"margin-bottom: 0em;line-height: 1.75em;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7S70WrDy6NVbbVn7nzGLzvgtLtCgJNeSpWhwibibewvoyqX8SUQp8ibXJsRiahhwHc9uibkNXYSyXGK8Xg/640?wx_fmt=jpeg\" style='margin: 0px;padding: 0px;max-width: 100%;height: auto !important;vertical-align: bottom;color: rgb(51, 51, 51);font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: normal;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;'/>\n</section>\n<section powered-by=\"werss\" style=\"margin-bottom: 0em;line-height: 1.75em;\">\n<span style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgb(34, 34, 34);font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration-style: initial;text-decoration-color: initial;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;'>\n          这个批次的黑蜜处理使用高甜的黄哥伦比亚树种\n         </span>\n<span style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgb(34, 34, 34);font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration-style: initial;text-decoration-color: initial;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;'>\n          ，黄色的咖啡鲜果采摘难度较大，在测试brix值后只选择糖度在22以上的鲜果。这个黑蜜批次的设计是想让其具有较高的body和密集的甜感。采摘后，鲜果会被置入密封的发酵桶中进行48小时的厌氧发酵，通过单向阀门的空气交换使氧气全部排出。之后会进行脱皮处理，留下大部分的果胶在豆子表面。之后将带有果胶的咖啡豆均匀铺在有顶棚遮挡的晒床上，每4小时翻动一次，以防止周围微生物的过度反应，晾晒20天左右，至含水率降至11%\n         </span>\n<span style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgb(34, 34, 34);font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration-style: initial;text-decoration-color: initial;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;'>\n          。\n         </span>\n</section>\n<p style=\"text-align: center;margin-bottom: 0em;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7S70WrDy6NVbbVn7nzGLzvg2h3JJF2LEXPNrdH3cGSujv4vOYicy2bhgGGpJJKGUBurGOAQN9qznyg/640?wx_fmt=jpeg\"/>\n</p>\n<section powered-by=\"werss\" style='margin: 0px 8px;padding: 0px;outline: 0px;max-width: 100%;color: rgb(34, 34, 34);font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: center;text-indent: 0px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"font-size: 12px;color: rgb(214, 214, 214);\">\n          本批次黑蜜处理晾晒 - 图片来源：咖篮\n         </span>\n<br/>\n</section>\n<section powered-by=\"werss\" style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;clear: both;min-height: 1em;color: rgb(34, 34, 34);font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-indent: 0px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<br/>\n</section>\n<section powered-by=\"werss\" style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;clear: both;min-height: 1em;color: rgb(34, 34, 34);font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-indent: 0px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;font-size: 14px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          公众号的文章板块有豆子信息\n         </span>\n</section>\n<section powered-by=\"werss\" style='margin: 0px;padding: 0px;outline: 0px;max-width: 100%;clear: both;min-height: 1em;color: rgb(34, 34, 34);font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-indent: 0px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<span style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;font-size: 14px;box-sizing: border-box !important;overflow-wrap: break-word !important;\">\n          淘宝店铺和有赞小程序可选购更多豆子～\n         </span>\n</section>\n<section powered-by=\"werss\" style='margin: 0px 0px 0em;padding: 0px;outline: 0px;max-width: 100%;min-height: 1em;color: rgb(34, 34, 34);font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-indent: 0px;text-transform: none;white-space: normal;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;line-height: 1.75em;box-sizing: border-box !important;overflow-wrap: break-word !important;'>\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Gr457cyFia7Q09FO8svc4MbsT6kYe0icjVt0iafAKEvQb4V0sg5ELeaSJuChicNO6jr9zxGVFVu7wDwt3ibVQgXa5ow/640?wx_fmt=png&amp;wxfrom=5&amp;wx_lazy=1&amp;wx_co=1\" style=\"margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: brea