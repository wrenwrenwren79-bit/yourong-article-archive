ection>\n<section powered-by=\"werss\" style=\"white-space: normal;line-height: 1.75em;\">\n<span style=\"font-size: 14px;\">\n          品种：卡杜拉 Caturra\n         </span>\n</section>\n<section powered-by=\"werss\" style=\"white-space: normal;line-height: 1.75em;\">\n<span style=\"font-size: 14px;\">\n          处理方式：\n          <span style='font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 14px;letter-spacing: 0.544px;background-color: rgb(255, 255, 255);'>\n           水洗 Washed\n          </span>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"white-space: normal;line-height: 1.75em;\">\n<span style=\"font-size: 14px;\">\n</span>\n</section>\n<section powered-by=\"werss\" style=\"white-space: normal;line-height: 1.75em;\">\n<span style=\"font-size: 14px;\">\n          风味：柑橘、红色莓果、蜜瓜\n         </span>\n</section>\n<section powered-by=\"werss\" style=\"white-space: normal;line-height: 1.75em;\">\n<span style=\"font-size: 14px;\">\n          Citrus, Red berries, Rock melon\n          <br/>\n</span>\n</section>\n<section powered-by=\"werss\" style=\"white-space: normal;line-height: 1.75em;\">\n<br/>\n</section>\n<section powered-by=\"werss\" style=\"white-space: normal;text-align: center;line-height: 1.75em;\">\n<img src=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/Gr457cyFia7TWPEXxn88NbEX8jW31ibicxlibHdoEULvMxNyHrPPR3dynYHVItkoXv4YBA1k9LvV46zSkEMiaMIAEFQ/640?wx_fmt=jpeg\" style=\"height: 804px;width: 578px;\"/>\n</section>\n<section powered-by=\"werss\" style=\"white-space: normal;text-align: center;line-height: 1.75em;\">\n<br/>\n</section>\n<section powered-by=\"werss\" style=\"white-space: normal;line-height: 1.75em;\">\n<span style=\"font-size: 14px;\">\n<strong>\n           庄园介绍\n          </strong>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-right: 8px;margin-left: 8px;white-space: normal;outline: 0px;max-width