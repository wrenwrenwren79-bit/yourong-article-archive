stemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;visibility: visible;line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;visibility: visible;\">\n          图片来自sweet maria's\n         </span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;font-variant-ligatures: normal;orphans: 2;widows: 2;text-decoration-style: initial;text-decoration-color: initial;clear: both;min-height: 1em;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);text-align: center;visibility: visible;line-height: 1.75em;'>\n<br style=\"outline: 0px;\"/>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;font-variant-ligatures: normal;orphans: 2;widows: 2;text-decoration-style: initial;text-decoration-color: initial;clear: both;min-height: 1em;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n<strong style=\"outline: 0px;\">\n<span style=\"outline: 0px;\">\n            关于处理\n           </span>\n</strong>\n</span>\n</section>\n<hr style='outline: 0px;letter-spacing: 0.544px;white-space: normal;font-variant-ligatures: normal;orphans: 2;widows: 2;text-decoration-style: initial;text-decoration-color: initial;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);border-style: solid;border-right-width: 0px;border-bottom-width: 0px;border-left-width: 0px;border-color: rgba(0, 0, 0, 0.098);transform-origin: 0px 0px;transform: scale(1, 0.5);'/>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;font-variant-ligatures: normal;orphans: 2;widows: 2;text-decoration-style: initial;text-decoration-color: initial;clear: both;min-height: 1em;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n          在肯尼亚，处理过程简要如下：\n          <br style=\"outline: 0px;\"/>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;font-variant-ligatures: normal;orphans: 2;widows: 2;text-decoration-style: initial;text-decoration-color: initial;clear: both;min-height: 1em;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n          - 咖农采收鲜果\n          <br style=\"outline: 0px;\"/>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;font-variant-ligatures: normal;orphans: 2;widows: 2;text-decoration-style: initial;text-decoration-color: initial;clear: both;min-height: 1em;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n          - 采收当天，运送到处理厂；（摩托车，自行车，人力背运都有）\n          <br style=\"outline: 0px;\"/>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;font-variant-ligatures: normal;orphans: 2;widows: 2;text-decoration-style: initial;text-decoration-color: initial;clear: both;min-height: 1em;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n          - 在处理厂，先将鲜果做挑选；当处理厂的质量员批准后才可计重算作售卖；\n          <br style=\"outline: 0px;\"/>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;font-variant-ligatures: normal;orphans: 2;widows: 2;text-decoration-style: initial;text-decoration-color: initial;clear: both;min-height: 1em;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n          -很多小农的鲜果会集中一批进行去皮处理\n          <br style=\"outline: 0px;\"/>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;font-variant-ligatures: normal;orphans: 2;widows: 2;text-decoration-style: initial;text-decoration-color: initial;clear: both;min-height: 1em;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n          -去皮后的带着果胶的咖啡豆静置发酵（无水）\n          <br style=\"outline: 0px;\"/>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;font-variant-ligatures: normal;orphans: 2;widows: 2;text-decoration-style: initial;text-decoration-color: initial;clear: both;min-height: 1em;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n          -隔天进行水槽中的刷洗\n          <br style=\"outline: 0px;\"/>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;font-variant-ligatures: normal;orphans: 2;widows: 2;text-decoration-style: initial;text-decoration-color: initial;clear: both;min-height: 1em;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n          -二次浸泡（根据每个处理厂的习惯，可能有不同质量等级的做二次浸泡或者不做）\n          <br style=\"outline: 0px;\"/>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;font-variant-ligatures: normal;orphans: 2;widows: 2;text-decoration-style: initial;text-decoration-color: initial;clear: both;min-height: 1em;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n          -搬运至晒床晾晒\n          <br style=\"outline: 0px;\"/>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;font-variant-ligatures: normal;orphans: 2;widows: 2;text-decoration-style: initial;text-decoration-color: initial;clear: both;min-height: 1em;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n          -晾晒约2周左右，收储到处理厂的仓库中\n         </span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0px;outline: 0px;letter-spacing: 0.544px;white-space: normal;font-variant-ligatures: normal;orphans: 2;widows: 2;text-decoration-style: initial;text-decoration-color: initial;clear: both;min-height: 1em;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;background-color: rgb(255, 255, 255);line-height: 1.75em;'>\n<span style=\"outline: 0px;font-size: 14px;\">\n<br/>\n</span>\n</section>\n<section powered-by=\"werss\" style='margin-bottom: 0em;white-space: normal;outline: 0px;letter-spacing: 0.544px;clear: both;min-height: 1em;color: rgb(34, 34, 34);font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif;font-variant-ligatures: normal;orphans: 2;widows: 2;background-color: rgb(255, 255, 255);text-decoration-style: initial;text-decoration-color: initial;text-align: center;line-height: 1.75em;'>\n<img src=\"https://mmbiz.qpic.cn/mmbiz_jpg/Gr457cyFia7SUmFynsJ8mZibzFwhDyicticjFTXlrJpJcjxiaqDStcT9MwwM2lMkcO9cZksLTz9doiaPlp0z12qhicDzA/640?wx_fmt=other&amp;wxfrom=5&am